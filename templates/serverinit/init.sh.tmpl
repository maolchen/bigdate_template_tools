#!/bin/bash
# ============================================================
# 服务器初始化脚本
# 主机: {{ .Hostname }} ({{ .IP }})
# ============================================================

set -e

# 颜色输出
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m'

log_info() { echo -e "${GREEN}[INFO]${NC} $1"; }
log_warn() { echo -e "${YELLOW}[WARN]${NC} $1"; }
log_error() { echo -e "${RED}[ERROR]${NC} $1"; }

HOSTNAME="{{ .Hostname }}"
IP="{{ .IP }}"

log_info "=========================================="
log_info "开始服务器初始化"
log_info "主机: ${HOSTNAME} (${IP})"
log_info "=========================================="

# ============================================================
# 设置主机名
# ============================================================
log_info "设置主机名..."
if command -v hostnamectl &> /dev/null; then
    sudo hostnamectl set-hostname ${HOSTNAME}
else
    sudo hostname ${HOSTNAME}
fi

# 更新 /etc/hosts
log_info "更新 /etc/hosts..."
if ! grep -q "${HOSTNAME}" /etc/hosts; then
    echo "${IP} ${HOSTNAME}" | sudo tee -a /etc/hosts
fi

# ============================================================
# 配置时区
# ============================================================
log_info "设置时区为 {{ .Vars.timezone }}..."
sudo timedatectl set-timezone {{ .Vars.timezone }}

# ============================================================
# 创建用户
# ============================================================
log_info "创建用户 {{ .Vars.user }}..."
if ! id {{ .Vars.user }} &>/dev/null; then
    sudo useradd -m -s /bin/bash {{ .Vars.user }}
    log_info "用户 {{ .Vars.user }} 创建成功"
else
    log_info "用户 {{ .Vars.user }} 已存在"
fi

# ============================================================
# 创建基础目录
# ============================================================
log_info "创建基础目录..."
sudo mkdir -p {{ .Vars.install_base_dir }}
sudo mkdir -p {{ .Vars.data_base_dir }}
sudo mkdir -p {{ .Vars.log_base_dir }}
sudo mkdir -p {{ .Vars.temp_dir }}
sudo mkdir -p {{ .Vars.software_dir }}

sudo chown -R {{ .Vars.user }}:{{ .Vars.group }} {{ .Vars.install_base_dir }}
sudo chown -R {{ .Vars.user }}:{{ .Vars.group }} {{ .Vars.data_base_dir }}
sudo chown -R {{ .Vars.user }}:{{ .Vars.group }} {{ .Vars.log_base_dir }}
sudo chown -R {{ .Vars.user }}:{{ .Vars.group }} {{ .Vars.temp_dir }}
sudo chown -R {{ .Vars.user }}:{{ .Vars.group }} {{ .Vars.software_dir }}

# ============================================================
# 配置系统参数
# ============================================================
log_info "配置系统参数..."

# sysctl 配置
sudo tee /etc/sysctl.d/99-bigdata.conf << 'EOF'
net.ipv4.ip_forward = 1
net.core.somaxconn = 65536
net.ipv4.tcp_max_syn_backlog = 8192
vm.swappiness = 0
vm.panic_on_oom = 0
vm.max_map_count = 2000000
vm.dirty_background_ratio = 5
fs.file-max = 6553560
EOF

sudo sysctl -p /etc/sysctl.d/99-bigdata.conf

# limits 配置
sudo tee /etc/security/limits.d/99-bigdata.conf << 'EOF'
* soft nofile 102400
* hard nofile 102400
* soft nproc 102400
* hard nproc 102400
* soft memlock unlimited
* hard memlock unlimited
root soft nproc unlimited
root hard nproc unlimited
EOF

# ============================================================
# 加载内核模块
# ============================================================
log_info "加载内核模块..."
for module in ip_vs ip_vs_rr ip_vs_wrr ip_vs_sh nf_conntrack br_netfilter; do
    if ! lsmod | grep -q ${module}; then
        sudo modprobe ${module} && log_info "已加载模块: ${module}"
    fi
done

# 开机自动加载
sudo tee /etc/modules-load.d/bigdata.conf << 'EOF'
ip_vs
ip_vs_rr
ip_vs_wrr
ip_vs_sh
nf_conntrack
br_netfilter
EOF

# ============================================================
# 配置 JDK 环境变量
# ============================================================
log_info "配置 JDK 环境变量..."
if [ -d "{{ .Vars.jdk_path }}/jdk{{ .Vars.jdk_version }}" ]; then
    grep -q 'JAVA_HOME' ~/.bashrc || {
        echo "" >> ~/.bashrc
        echo "# JDK Environment" >> ~/.bashrc
        echo "export JAVA_HOME={{ .Vars.jdk_path }}/jdk{{ .Vars.jdk_version }}" >> ~/.bashrc
        echo "export PATH=\$JAVA_HOME/bin:\$PATH" >> ~/.bashrc
    }
    log_info "JDK 环境变量已配置"
else
    log_warn "JDK 目录不存在: {{ .Vars.jdk_path }}/jdk{{ .Vars.jdk_version }}"
fi

log_info "=========================================="
log_info "服务器初始化完成！"
log_info "请重启系统或重新登录以生效所有配置"
log_info "=========================================="
