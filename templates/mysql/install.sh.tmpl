#!/bin/bash
# ============================================================
# MySQL 安装脚本 (Docker部署)
# 服务: mysql
# 节点: {{ .Instance.Node.NodeName }} ({{ .Instance.Node.IP }})
# ============================================================

set -e

# ==================== 颜色定义 ====================
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

# ==================== 变量定义 ====================
CONTAINER_NAME="{{ .Instance.Vars.container_name }}"
MYSQL_IMAGE="{{ .Instance.Vars.mysql_image }}"
MYSQL_IMAGE_FILE="{{ .Global.software_dir }}/{{ .Instance.Vars.package_subdir }}/{{ .Instance.Vars.image_name }}"
MYSQL_DATA_DIR="{{ .Global.install_base_dir }}/{{ .Instance.Vars.mysql_data_subdir }}"
MYSQL_CONFIG_DIR="{{ .Global.install_base_dir }}/{{ .Instance.Vars.mysql_config_subdir }}"
INIT_DIR="{{ .Global.install_base_dir }}/{{ .Instance.Vars.init_subdir }}"
TEMP_DIR="{{ .Global.temp_dir }}"
SQL_TOOLS_DIR="{{ .Global.data_base_dir }}/{{ .Instance.Vars.sql_tools_subdir }}"

# ==================== 日志函数 ====================
log_info() {
    echo -e "${GREEN}[INFO]${NC} $1"
}

log_warn() {
    echo -e "${YELLOW}[WARN]${NC} $1"
}

log_error() {
    echo -e "${RED}[ERROR]${NC} $1"
}

log_success() {
    echo -e "${GREEN}[SUCCESS]${NC} $1"
}

# ==================== 检查函数 ====================
check_docker() {
    if ! command -v docker &> /dev/null; then
        log_error "Docker未安装，请先安装Docker"
        return 1
    fi
    
    if ! docker info &> /dev/null; then
        log_error "Docker服务未运行，请先启动Docker"
        return 1
    fi
    
    log_success "Docker检查通过"
    return 0
}

check_mysql_container() {
    if docker ps -a --format '{{.Names}}' | grep -q "^${CONTAINER_NAME}$"; then
        return 0
    fi
    return 1
}

check_mysql_running() {
    if docker ps --format '{{.Names}}' | grep -q "^${CONTAINER_NAME}$"; then
        return 0
    fi
    return 1
}

# ==================== 清理旧容器 ====================
clean_old_container() {
    log_info "检查并清理旧的MySQL容器..."
    
    if check_mysql_container; then
        log_warn "发现已存在的MySQL容器: $CONTAINER_NAME"
        log_info "停止并删除旧容器..."
        docker rm -f "$CONTAINER_NAME"
        log_success "旧容器已删除"
    else
        log_info "未发现已存在的MySQL容器"
    fi
}

# ==================== 上传镜像 ====================
upload_image() {
    log_info "上传MySQL Docker镜像..."
    
    if [ ! -f "$MYSQL_IMAGE_FILE" ]; then
        log_error "MySQL镜像文件不存在: $MYSQL_IMAGE_FILE"
        return 1
    fi
    
    log_info "镜像文件: $MYSQL_IMAGE_FILE"
    
    # 检查临时目录
    if [ ! -d "$TEMP_DIR" ]; then
        mkdir -p "$TEMP_DIR"
    fi
    
    # 复制镜像到临时目录
    local dest_file="${TEMP_DIR}/{{ .Instance.Vars.image_name }}"
    if [ "$MYSQL_IMAGE_FILE" != "$dest_file" ]; then
        cp -f "$MYSQL_IMAGE_FILE" "$dest_file"
        log_info "镜像已复制到: $dest_file"
    fi
    
    return 0
}

# ==================== 加载镜像 ====================
load_image() {
    log_info "加载MySQL Docker镜像..."
    
    local image_file="${TEMP_DIR}/{{ .Instance.Vars.image_name }}"
    
    # 检查镜像是否已存在
    if docker images --format '{{.Repository}}:{{.Tag}}' | grep -q "^${MYSQL_IMAGE}$"; then
        log_success "MySQL镜像已存在: $MYSQL_IMAGE"
        return 0
    fi
    
    if [ ! -f "$image_file" ]; then
        log_error "镜像文件不存在: $image_file"
        return 1
    fi
    
    log_info "加载镜像: $image_file"
    docker load < "$image_file"
    
    log_success "MySQL镜像加载完成"
    return 0
}

# ==================== 创建目录 ====================
create_directories() {
    log_info "创建MySQL相关目录..."
    
    # 数据目录
    if [ ! -d "$MYSQL_DATA_DIR" ]; then
        mkdir -p "$MYSQL_DATA_DIR"
        log_info "创建数据目录: $MYSQL_DATA_DIR"
    fi
    
    # 配置目录
    if [ ! -d "$MYSQL_CONFIG_DIR" ]; then
        mkdir -p "$MYSQL_CONFIG_DIR"
        log_info "创建配置目录: $MYSQL_CONFIG_DIR"
    fi
    
    # 初始化脚本目录
    if [ ! -d "$INIT_DIR" ]; then
        mkdir -p "$INIT_DIR"
        log_info "创建初始化脚本目录: $INIT_DIR"
    fi
    
    log_success "目录创建完成"
    return 0
}

# ==================== 准备配置文件 ====================
prepare_config() {
    log_info "准备MySQL配置文件..."
    
    local script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
    
    # 复制my.cnf
    if [ -f "${script_dir}/my.cnf" ]; then
        cp -f "${script_dir}/my.cnf" "${MYSQL_CONFIG_DIR}/my.cnf"
        log_info "配置文件已复制: ${MYSQL_CONFIG_DIR}/my.cnf"
    else
        log_error "配置文件模板不存在: ${script_dir}/my.cnf"
        return 1
    fi
    
    # 复制启动脚本
    if [ -f "${script_dir}/start_container.sh" ]; then
        cp -f "${script_dir}/start_container.sh" "${INIT_DIR}/start_container.sh"
        chmod 700 "${INIT_DIR}/start_container.sh"
        log_info "启动脚本已复制: ${INIT_DIR}/start_container.sh"
    else
        log_error "启动脚本模板不存在: ${script_dir}/start_container.sh"
        return 1
    fi
    
    # 复制初始化脚本
    if [ -f "${script_dir}/init_db.sh" ]; then
        cp -f "${script_dir}/init_db.sh" "${INIT_DIR}/init_db.sh"
        chmod 700 "${INIT_DIR}/init_db.sh"
        log_info "初始化脚本已复制: ${INIT_DIR}/init_db.sh"
    fi
    
    if [ -f "${script_dir}/init_user.sh" ]; then
        cp -f "${script_dir}/init_user.sh" "${INIT_DIR}/init_user.sh"
        chmod 700 "${INIT_DIR}/init_user.sh"
        log_info "用户初始化脚本已复制: ${INIT_DIR}/init_user.sh"
    fi
    
    log_success "配置文件准备完成"
    return 0
}

# ==================== 启动容器 ====================
start_container() {
    log_info "启动MySQL容器..."
    
    if check_mysql_running; then
        log_warn "MySQL容器已在运行中"
        return 0
    fi
    
    # 执行启动脚本
    if [ -f "${INIT_DIR}/start_container.sh" ]; then
        bash "${INIT_DIR}/start_container.sh"
    else
        log_error "启动脚本不存在: ${INIT_DIR}/start_container.sh"
        return 1
    fi
    
    # 等待容器启动
    sleep 5
    
    if check_mysql_running; then
        log_success "MySQL容器启动成功"
    else
        log_error "MySQL容器启动失败"
        return 1
    fi
    
    return 0
}

# ==================== 初始化数据库 ====================
initialize_database() {
    log_info "初始化MySQL数据库..."
    
    # 设置时区
    if [ -f "${INIT_DIR}/init_db.sh" ]; then
        log_info "设置时区..."
        bash "${INIT_DIR}/init_db.sh"
    fi
    
    # 创建用户和数据库
    if [ -f "${INIT_DIR}/init_user.sh" ]; then
        log_info "创建用户和数据库..."
        bash "${INIT_DIR}/init_user.sh"
    fi
    
    log_success "数据库初始化完成"
    return 0
}

# ==================== 验证安装 ====================
verify_installation() {
    log_info "验证MySQL安装..."
    
    # 检查容器状态
    if ! check_mysql_running; then
        log_error "MySQL容器未运行"
        return 1
    fi
    
    log_success "MySQL容器运行正常"
    
    # 检查端口
    if ss -tuln | grep -q ":{{ .Instance.Vars.container_port }} "; then
        log_success "MySQL端口({{ .Instance.Vars.container_port }})正在监听"
    else
        log_warn "MySQL端口({{ .Instance.Vars.container_port }})未监听"
    fi
    
    # 显示容器信息
    log_info "容器信息:"
    docker ps --filter "name=$CONTAINER_NAME" --format "table {{.Names}}\t{{.Image}}\t{{.Status}}\t{{.Ports}}"
    
    return 0
}

# ==================== 主函数 ====================
main() {
    echo ""
    echo "========================================"
    echo "  MySQL 安装脚本 (Docker部署)"
    echo "  节点: {{ .Instance.Node.NodeName }} ({{ .Instance.Node.IP }})"
    echo "  容器名: ${CONTAINER_NAME}"
    echo "========================================"
    echo ""
    
    # 检查Docker
    if ! check_docker; then
        log_error "Docker检查失败！"
        exit 1
    fi
    
    # 清理旧容器
    clean_old_container
    
    # 上传镜像
    if ! upload_image; then
        log_error "镜像上传失败！"
        exit 1
    fi
    
    # 加载镜像
    if ! load_image; then
        log_error "镜像加载失败！"
        exit 1
    fi
    
    # 创建目录
    if ! create_directories; then
        log_error "目录创建失败！"
        exit 1
    fi
    
    # 准备配置文件
    if ! prepare_config; then
        log_error "配置文件准备失败！"
        exit 1
    fi
    
    # 启动容器
    if ! start_container; then
        log_error "容器启动失败！"
        exit 1
    fi
    
    # 初始化数据库
    if ! initialize_database; then
        log_warn "数据库初始化失败，可能需要手动执行初始化脚本"
    fi
    
    # 验证安装
    if verify_installation; then
        log_success "MySQL安装完成！"
        echo ""
        log_info "安装信息:"
        echo "  - 容器名: ${CONTAINER_NAME}"
        echo "  - MySQL版本: {{ .Instance.Vars.mysql_image }}"
        echo "  - 数据目录: ${MYSQL_DATA_DIR}"
        echo "  - 配置目录: ${MYSQL_CONFIG_DIR}"
        echo "  - 初始化脚本目录: ${INIT_DIR}"
        echo "  - 监听端口: {{ .Instance.Vars.container_port }}"
        echo ""
        log_info "初始化脚本位置:"
        echo "  - 启动容器: ${INIT_DIR}/start_container.sh"
        echo "  - 初始化数据库: ${INIT_DIR}/init_db.sh"
        echo "  - 创建用户: ${INIT_DIR}/init_user.sh"
        echo ""
        exit 0
    else
        log_error "MySQL安装验证失败！"
        exit 1
    fi
}

# 执行主函数
main "$@"
