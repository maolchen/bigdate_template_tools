#!/bin/bash
# Doris 系统初始化脚本
# 执行节点: 所有 Doris 节点（FE 和 BE）
# 用途: 系统环境初始化、依赖安装

set -e

# ============================================================
# 全局变量（从 global 读取）
# ============================================================
RUN_USER="{{.Global.user}}"
RUN_GROUP="{{.Global.group}}"
JAVA_HOME="{{.Global.java_home}}"

# ============================================================
# 辅助函数
# ============================================================
run_as_root() {
    if [ "$RUN_USER" = "root" ]; then
        "$@"
    else
        sudo "$@"
    fi
}

log_info() {
    echo "[$(date '+%Y-%m-%d %H:%M:%S')] [INFO] $1"
}

log_error() {
    echo "[$(date '+%Y-%m-%d %H:%M:%S')] [ERROR] $1" >&2
}

log_warn() {
    echo "[$(date '+%Y-%m-%d %H:%M:%S')] [WARN] $1"
}

log_success() {
    echo "[$(date '+%Y-%m-%d %H:%M:%S')] [SUCCESS] $1"
}

# ============================================================
# 开始初始化
# ============================================================
echo "============================================"
echo "Doris 系统初始化脚本"
echo "============================================"
echo "主机名: $(hostname)"
echo "============================================"

# ============================================================
# 步骤1: 关闭透明大页
# ============================================================
log_info "步骤1: 关闭透明大页..."

if [ -f /sys/kernel/mm/transparent_hugepage/enabled ]; then
    run_as_root sh -c 'echo never > /sys/kernel/mm/transparent_hugepage/enabled'
    log_success "已关闭透明大页 (enabled)"
fi

if [ -f /sys/kernel/mm/transparent_hugepage/defrag ]; then
    run_as_root sh -c 'echo never > /sys/kernel/mm/transparent_hugepage/defrag'
    log_success "已关闭透明大页 (defrag)"
fi

# 添加到 rc.local 确保重启后生效
RC_LOCAL=/etc/rc.d/rc.local
if [ -f "$RC_LOCAL" ]; then
    if ! grep -q "transparent_hugepage" "$RC_LOCAL" 2>/dev/null; then
        run_as_root sh -c "echo '# Disable transparent hugepage for Doris' >> $RC_LOCAL"
        run_as_root sh -c "echo 'echo never > /sys/kernel/mm/transparent_hugepage/enabled' >> $RC_LOCAL"
        run_as_root sh -c "echo 'echo never > /sys/kernel/mm/transparent_hugepage/defrag' >> $RC_LOCAL"
        run_as_root chmod +x "$RC_LOCAL"
        log_info "已添加透明大页关闭到 rc.local"
    fi
fi

# ============================================================
# 步骤2: 设置系统最大打开文件句柄
# ============================================================
log_info "步骤2: 设置系统最大打开文件句柄..."

LIMITS_CONF=/etc/security/limits.conf
if ! grep -q "nofile 65536" "$LIMITS_CONF" 2>/dev/null; then
    run_as_root sh -c "echo '* soft nofile 65536' >> $LIMITS_CONF"
    run_as_root sh -c "echo '* hard nofile 65536' >> $LIMITS_CONF"
    log_success "已设置文件句柄限制"
else
    log_info "文件句柄限制已设置，跳过"
fi

# ============================================================
# 步骤3: 内核参数调整
# ============================================================
log_info "步骤3: 调整内核参数..."

SYSCTL_CONF=/etc/sysctl.conf

# 检查并添加 fs.file-max
if ! grep -q "^fs.file-max" "$SYSCTL_CONF" 2>/dev/null; then
    run_as_root sh -c 'echo "fs.file-max = 6553560" >> /etc/sysctl.conf'
    log_info "已添加 fs.file-max 配置"
fi

# 检查并添加 vm.max_map_count
if ! grep -q "^vm.max_map_count" "$SYSCTL_CONF" 2>/dev/null; then
    run_as_root sh -c 'echo "vm.max_map_count=2000000" >> /etc/sysctl.conf'
    log_info "已添加 vm.max_map_count 配置"
fi

# 立即生效
run_as_root sysctl -p
log_success "内核参数已生效"

# ============================================================
# 步骤4: 关闭交换分区
# ============================================================
log_info "步骤4: 关闭交换分区..."

# 检查 swap 是否已关闭
if swapon --show 2>/dev/null | grep -q "swap"; then
    run_as_root swapoff -a
    log_info "已关闭交换分区"
    
    # 注释 fstab 中的 swap 行
    if grep -q "^[^#].*swap" /etc/fstab 2>/dev/null; then
        run_as_root sed -i '/swap/s/^/# /' /etc/fstab
        log_info "已注释 fstab 中的 swap 配置"
    fi
else
    log_info "交换分区已关闭，跳过"
fi

# ============================================================
# 步骤5: 安装依赖包
# ============================================================
log_info "步骤5: 安装依赖包..."

# 检查并安装 gcc
if ! command -v gcc &>/dev/null; then
    log_info "安装 gcc-c++..."
    run_as_root yum install -y gcc-c++ bash-completion
else
    GCC_VERSION=$(gcc --version | head -n1 | grep -oE '[0-9]+\.[0-9]+' | head -n1)
    log_info "gcc 版本: $GCC_VERSION"
fi

# 安装 MySQL 客户端
if ! command -v mysql &>/dev/null; then
    log_info "安装 MySQL 客户端..."
    run_as_root yum install -y mysql || run_as_root yum install -y mariadb
else
    log_info "MySQL 客户端已安装"
fi

log_success "依赖包安装完成"

# ============================================================
# 步骤6: 检查 AVX2 指令集
# ============================================================
log_info "步骤6: 检查 AVX2 指令集支持..."

if grep -q avx2 /proc/cpuinfo 2>/dev/null; then
    log_success "CPU 支持 AVX2 指令集"
    log_info "可以使用标准版 Doris 安装包"
else
    log_warn "CPU 不支持 AVX2 指令集"
    log_warn "请使用 no-avx2 版本的 Doris 安装包"
    log_warn "下载地址: apache-doris-2.1.3-bin-x64-noavx2.tar.gz"
fi

# ============================================================
# 步骤7: 检查磁盘文件系统
# ============================================================
log_info "步骤7: 检查磁盘文件系统..."

DATA_DIR="{{.Global.data_base_dir}}"
FS_TYPE=$(df -T "$DATA_DIR" 2>/dev/null | awk 'NR==2 {print $2}')

if [ "$FS_TYPE" = "ext4" ] || [ "$FS_TYPE" = "xfs" ]; then
    log_success "文件系统类型符合要求: $FS_TYPE"
else
    log_warn "当前文件系统: $FS_TYPE"
    log_warn "建议使用 ext4 或 xfs 文件系统"
fi

# ============================================================
# 初始化完成
# ============================================================
echo ""
echo "============================================"
echo "Doris 系统初始化完成！"
echo "============================================"
echo ""
echo "已完成的配置:"
echo "  - 透明大页已关闭"
echo "  - 文件句柄限制已设置 (65536)"
echo "  - 内核参数已调整 (fs.file-max, vm.max_map_count)"
echo "  - 交换分区已关闭"
echo "  - 依赖包已安装 (gcc, mysql-client)"
echo ""
echo "注意: 如修改了内核参数，建议重启服务器以确保完全生效"
echo ""
echo "后续步骤:"
echo "  FE 节点: bash install_fe.sh"
echo "  BE 节点: 等待 FE 安装完成后，执行 install_be.sh"
