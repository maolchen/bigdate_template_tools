# ============================================================
# Zookeeper 配置文件
# 主机: {{ .Hostname }} ({{ .IP }})
# 节点: {{ .NodeName }} (索引: {{ .NodeIndex }}, myid: {{ .AutoID }})
# ============================================================

# 心跳时间（毫秒）
tickTime={{ .ServiceVars.tick_time }}

# 初始化同步阶段能容忍的心跳数
initLimit={{ .ServiceVars.init_limit }}

# 请求响应阶段能容忍的心跳数
syncLimit={{ .ServiceVars.sync_limit }}

# 数据目录
dataDir={{ globalVar "data_base_dir" }}/zookeeper/data

# 客户端端口
clientPort={{ .ServiceVars.client_port }}

# ============================================================
# 服务器列表（自动生成）
# 格式：server.<myid>=<ip>:<server_port>:<election_port>
# ============================================================
{{- $serverPort := .ServiceVars.server_port }}
{{- $electionPort := .ServiceVars.election_port }}
{{- range serviceNodes "zookeeper" }}
server.{{ .auto_id }}={{ .ip }}:{{ $serverPort }}:{{ $electionPort }}
{{- end }}
