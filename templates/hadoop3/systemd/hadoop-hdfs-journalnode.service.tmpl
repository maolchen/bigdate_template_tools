[Unit]
Description=Hadoop HDFS JournalNode
Documentation=https://hadoop.apache.org/docs/r3.3.6/hadoop-project-dist/hadoop-hdfs/HDFSHighAvailabilityWithQJM.html
After=network-online.target
Wants=network-online.target

[Service]
Type=forking
User={{.Global.user}}
Group={{.Global.group}}
Environment="JAVA_HOME={{.Global.java_home}}"
Environment="HADOOP_HOME={{.Global.install_base_dir}}/{{.Instance.Vars.install_subdir}}"
Environment="HADOOP_CONF_DIR={{.Global.install_base_dir}}/{{.Instance.Vars.install_subdir}}/etc/hadoop"
Environment="HADOOP_PID_DIR={{.Global.install_base_dir}}/{{.Instance.Vars.install_subdir}}/pids"
Environment="HDFS_NAMENODE_USER={{.Global.user}}"
Environment="HDFS_DATANODE_USER={{.Global.user}}"
Environment="HDFS_JOURNALNODE_USER={{.Global.user}}"
Environment="HDFS_ZKFC_USER={{.Global.user}}"
Environment="YARN_RESOURCEMANAGER_USER={{.Global.user}}"
Environment="YARN_NODEMANAGER_USER={{.Global.user}}"
ExecStart={{.Global.install_base_dir}}/{{.Instance.Vars.install_subdir}}/bin/hdfs --daemon start journalnode
ExecStop={{.Global.install_base_dir}}/{{.Instance.Vars.install_subdir}}/bin/hdfs --daemon stop journalnode
PIDFile={{.Global.install_base_dir}}/{{.Instance.Vars.install_subdir}}/pids/hadoop-hdfs-journalnode.pid
Restart=on-failure
RestartSec=10
TimeoutSec=300
LimitNOFILE=65536
LimitNPROC=65536

[Install]
WantedBy=multi-user.target
