#!/bin/bash
# Hadoop 3 ZKFC 启动脚本
# 使用方法: bash start_zkfc.sh
# 说明: 使用 systemd 启动 ZKFC 服务
# 注意: 必须确保 NameNode 已启动！

set -e

# ============================================================
# 全局变量
# ============================================================
INSTALL_BASE_DIR="{{.Global.install_base_dir}}"
DATA_BASE_DIR="{{.Global.data_base_dir}}"
RUN_USER="{{.Global.user}}"
RUN_GROUP="{{.Global.group}}"
JAVA_HOME="{{.Global.java_home}}"

# ============================================================
# 辅助函数
# ============================================================
run_as_root() {
    if [ "$RUN_USER" = "root" ]; then
        "$@"
    else
        sudo "$@"
    fi
}

log_info() {
    echo "[$(date '+%Y-%m-%d %H:%M:%S')] [INFO] $1"
}

log_error() {
    echo "[$(date '+%Y-%m-%d %H:%M:%S')] [ERROR] $1" >&2
}

log_warn() {
    echo "[$(date '+%Y-%m-%d %H:%M:%S')] [WARN] $1"
}

log_success() {
    echo "[$(date '+%Y-%m-%d %H:%M:%S')] [SUCCESS] $1"
}

check_port() {
    local host=$1
    local port=$2
    if timeout 5 bash -c "echo > /dev/tcp/${host}/${port}" 2>/dev/null; then
        return 0
    fi
    return 1
}

# ============================================================
# Hadoop 配置
# ============================================================
HADOOP_HOME="${INSTALL_BASE_DIR}/{{.Instance.Vars.install_subdir}}"
HADOOP_CONF_DIR="${HADOOP_HOME}/etc/hadoop"
NAMESERVICE="{{.Instance.Vars.nameservice}}"
NN_RPC_PORT="{{.Instance.Vars.namenode_rpc_port}}"
SERVICE_NAME="hadoop-hdfs-zkfc"

# ============================================================
# 开始启动
# ============================================================
echo "============================================"
echo "Hadoop 3 ZKFC 启动脚本"
echo "============================================"
echo "主机名: $(hostname)"
echo "Nameservice: ${NAMESERVICE}"
echo "============================================"

# ============================================================
# 步骤1: 检查前置条件
# ============================================================
log_info "步骤1: 检查前置条件..."

# 检查Hadoop安装
if [ ! -d "${HADOOP_HOME}" ]; then
    log_error "Hadoop未安装，请先执行 install_binary.sh"
    exit 1
fi

# 检查配置文件
if [ ! -f "${HADOOP_CONF_DIR}/hdfs-site.xml" ]; then
    log_error "配置文件不存在，请先执行 deploy_config.sh"
    exit 1
fi

log_info "前置条件检查通过"

# ============================================================
# 步骤2: 检查 NameNode 状态
# ============================================================
log_info "步骤2: 检查 NameNode 状态..."
log_warn "必须确保 NameNode 已启动！"

NN_READY=false

{{- range $i, $inst := (serviceNodes "hadoop3/namenode") }}
log_info "检查 NameNode: {{$inst.Node.Hostname}} ({{$inst.Node.IP}})"
if check_port "{{$inst.Node.IP}}" "${NN_RPC_PORT}"; then
    log_success "NameNode {{$inst.Node.Hostname}} 可连接"
    NN_READY=true
fi
{{- end }}

if [ "$NN_READY" = "false" ]; then
    log_error "无法连接到任何 NameNode，请先启动 NameNode"
    exit 1
fi

# ============================================================
# 步骤3: 检查 ZooKeeper 状态
# ============================================================
log_info "步骤3: 检查 ZooKeeper 状态..."

ZK_READY=false

{{- range $i, $inst := (serviceNodes "zookeeper") }}
if check_port "{{$inst.Node.IP}}" "2181"; then
    log_info "ZooKeeper {{$inst.Node.Hostname}} 可连接"
    ZK_READY=true
fi
{{- end }}

if [ "$ZK_READY" = "false" ]; then
    log_error "无法连接到 ZooKeeper，请确保 ZooKeeper 已启动"
    exit 1
fi

# ============================================================
# 步骤4: 部署并启用 systemd 服务
# ============================================================
log_info "步骤4: 部署 systemd 服务文件..."

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
SERVICE_FILE="${SCRIPT_DIR}/systemd/${SERVICE_NAME}.service"

if [ ! -f "${SERVICE_FILE}" ]; then
    log_error "未找到 systemd 服务文件: ${SERVICE_FILE}"
    exit 1
fi

# 部署服务文件
run_as_root cp "${SERVICE_FILE}" /etc/systemd/system/
run_as_root chmod 644 /etc/systemd/system/${SERVICE_NAME}.service
run_as_root systemctl daemon-reload
log_info "systemd 服务文件已部署"

# 启用开机自启动
run_as_root systemctl enable ${SERVICE_NAME}
log_info "systemd 服务已启用"

# ============================================================
# 步骤5: 检查服务状态
# ============================================================
log_info "步骤5: 检查 ZKFC 状态..."

if systemctl is-active --quiet ${SERVICE_NAME} 2>/dev/null; then
    log_info "ZKFC 已在运行"
    systemctl status ${SERVICE_NAME} --no-pager
    exit 0
fi

# ============================================================
# 步骤6: 使用 systemctl 启动服务
# ============================================================
log_info "步骤6: 使用 systemctl 启动 ZKFC..."
log_warn "ZKFC 会自动监控 NameNode 状态并实现故障转移"

run_as_root systemctl start ${SERVICE_NAME}
sleep 3

# ============================================================
# 步骤7: 验证启动
# ============================================================
log_info "步骤7: 验证启动..."

# 检查 systemd 状态
if systemctl is-active --quiet ${SERVICE_NAME}; then
    log_success "ZKFC 启动成功"
    systemctl status ${SERVICE_NAME} --no-pager
else
    log_error "ZKFC 启动失败"
    log_error "查看日志: sudo journalctl -u ${SERVICE_NAME} -n 50"
    exit 1
fi

# ============================================================
# 步骤8: 验证 NameNode HA 状态
# ============================================================
log_info "步骤8: 验证 NameNode HA 状态..."

sleep 5

echo ""
echo "NameNode HA 状态:"
${HADOOP_HOME}/bin/hdfs haadmin -getAllServiceState 2>/dev/null || log_warn "无法获取 HA 状态"

# ============================================================
# 启动完成
# ============================================================
echo ""
echo "============================================"
echo "ZKFC 启动完成！"
echo "============================================"
echo ""
echo "管理命令:"
echo "  查看状态: sudo systemctl status ${SERVICE_NAME}"
echo "  停止服务: sudo systemctl stop ${SERVICE_NAME}"
echo "  重启服务: sudo systemctl restart ${SERVICE_NAME}"
echo "  查看日志: sudo journalctl -u ${SERVICE_NAME} -f"
echo ""
echo "HDFS 命令:"
echo "  hdfs haadmin -getAllServiceState"
echo ""
echo "后续步骤:"
echo "  启动 DataNode: bash start_datanode.sh"
echo "  启动 YARN: bash start_yarn.sh"
