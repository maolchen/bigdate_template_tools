#!/bin/bash
# Hadoop 3 服务状态验证脚本
# 使用方法: bash check.sh [--verbose]
# 说明: 检查Hadoop各组件的运行状态

set -e

# ============================================================
# 全局变量
# ============================================================
INSTALL_BASE_DIR="{{.Global.install_base_dir}}"
DATA_BASE_DIR="{{.Global.data_base_dir}}"
RUN_USER="{{.Global.user}}"
JAVA_HOME="{{.Global.java_home}}"

# ============================================================
# 辅助函数
# ============================================================
log_info() {
    echo "[INFO] $1"
}

log_success() {
    echo "[\033[32mOK\033[0m] $1"
}

log_error() {
    echo "[\033[31mFAIL\033[0m] $1"
}

log_warn() {
    echo "[\033[33mWARN\033[0m] $1"
}

check_port() {
    local port=$1
    local service=$2
    
    if netstat -tuln 2>/dev/null | grep -q ":${port} " || ss -tuln 2>/dev/null | grep -q ":${port} "; then
        log_success "${service} 端口 ${port} 正在监听"
        return 0
    else
        log_error "${service} 端口 ${port} 未监听"
        return 1
    fi
}

check_process_by_name() {
    local process_name=$1
    local service=$2
    
    if jps 2>/dev/null | grep -q "${process_name}"; then
        local pid=$(jps | grep "${process_name}" | awk '{print $1}')
        log_success "${service} 进程运行中 (PID: ${pid})"
        return 0
    else
        log_error "${service} 进程未运行"
        return 1
    fi
}

check_systemd_service() {
    local service=$1
    
    if systemctl is-active ${service} >/dev/null 2>&1; then
        log_success "systemd 服务 ${service} 运行中"
        return 0
    else
        log_warn "systemd 服务 ${service} 未运行"
        return 1
    fi
}

# ============================================================
# Hadoop 配置
# ============================================================
HADOOP_HOME="${INSTALL_BASE_DIR}/{{.Instance.Vars.install_subdir}}"
HADOOP_CONF_DIR="${HADOOP_HOME}/etc/hadoop"
NAMESERVICE="{{.Instance.Vars.nameservice}}"

# 设置环境变量
export JAVA_HOME=${JAVA_HOME}
export HADOOP_HOME=${HADOOP_HOME}
export HADOOP_CONF_DIR=${HADOOP_CONF_DIR}
export HDFS_NAMENODE_USER=${RUN_USER}
export HDFS_DATANODE_USER=${RUN_USER}
export HDFS_JOURNALNODE_USER=${RUN_USER}
export HDFS_ZKFC_USER=${RUN_USER}
export YARN_RESOURCEMANAGER_USER=${RUN_USER}
export YARN_NODEMANAGER_USER=${RUN_USER}

PATH=${HADOOP_HOME}/bin:${HADOOP_HOME}/sbin:${PATH}

# ============================================================
# 参数解析
# ============================================================
VERBOSE=false
while [[ $# -gt 0 ]]; do
    case $1 in
        --verbose|-v)
            VERBOSE=true
            shift
            ;;
        *)
            shift
            ;;
    esac
done

# ============================================================
# 开始检查
# ============================================================
echo "============================================"
echo "Hadoop 3 服务状态检查"
echo "============================================"
echo "主机名: $(hostname)"
echo "时间: $(date '+%Y-%m-%d %H:%M:%S')"
echo "============================================"
echo ""

TOTAL=0
PASSED=0
FAILED=0

check_and_count() {
    local cmd="$1"
    shift
    TOTAL=$((TOTAL + 1))
    if eval "$cmd"; then
        PASSED=$((PASSED + 1))
        return 0
    else
        FAILED=$((FAILED + 1))
        return 1
    fi
}

# ============================================================
# 1. HDFS 组件检查
# ============================================================
echo "=== HDFS 组件状态 ==="
echo ""

# JournalNode
check_and_count "check_process_by_name JournalNode JournalNode" || true
check_and_count "check_port 8485 JournalNode" || true
echo ""

# NameNode
check_and_count "check_process_by_name NameNode NameNode" || true
check_and_count "check_port 9870 'NameNode Web UI'" || true
check_and_count "check_port 8020 'NameNode RPC'" || true
echo ""

# ZKFC
check_and_count "check_process_by_name DFSZKFailoverController ZKFC" || true
echo ""

# DataNode
check_and_count "check_process_by_name DataNode DataNode" || true
check_and_count "check_port 9864 'DataNode Web UI'" || true
check_and_count "check_port 9866 'DataNode Data Transfer'" || true
echo ""

# ============================================================
# 2. YARN 组件检查
# ============================================================
echo "=== YARN 组件状态 ==="
echo ""

# ResourceManager
check_and_count "check_process_by_name ResourceManager ResourceManager" || true
check_and_count "check_port 8088 'ResourceManager Web UI'" || true
check_and_count "check_port 8032 'ResourceManager RPC'" || true
echo ""

# NodeManager
check_and_count "check_process_by_name NodeManager NodeManager" || true
check_and_count "check_port 8042 'NodeManager Web UI'" || true
echo ""

# ============================================================
# 3. HDFS 功能检查
# ============================================================
echo "=== HDFS 功能检查 ==="
echo ""

# 检查HDFS安全模式
if command -v hdfs >/dev/null 2>&1; then
    SAFE_MODE=$(hdfs dfsadmin -safemode get 2>/dev/null || echo "Unknown")
    if echo "$SAFE_MODE" | grep -q "OFF"; then
        log_success "HDFS 已退出安全模式"
        TOTAL=$((TOTAL + 1))
        PASSED=$((PASSED + 1))
    else
        log_warn "HDFS 可能处于安全模式: ${SAFE_MODE}"
        TOTAL=$((TOTAL + 1))
        PASSED=$((PASSED + 1))  # 安全模式不算失败
    fi
    echo ""
    
    # 检查NameNode HA状态
    echo "NameNode HA 状态:"
    if hdfs haadmin -getAllServiceState 2>/dev/null; then
        log_success "NameNode HA 状态获取成功"
    else
        log_warn "无法获取 NameNode HA 状态"
    fi
    echo ""
fi

# ============================================================
# 4. YARN 功能检查
# ============================================================
echo "=== YARN 功能检查 ==="
echo ""

if command -v yarn >/dev/null 2>&1; then
    # 检查YARN节点状态
    echo "YARN NodeManager 列表:"
    if yarn node -list 2>/dev/null | head -10; then
        log_success "YARN 节点列表获取成功"
    else
        log_warn "无法获取 YARN 节点列表"
    fi
    echo ""
fi

# ============================================================
# 5. systemd 服务检查
# ============================================================
echo "=== systemd 服务状态 ==="
echo ""

for svc in hadoop-hdfs-journalnode hadoop-hdfs-namenode hadoop-hdfs-zkfc hadoop-hdfs-datanode hadoop-yarn-resourcemanager hadoop-yarn-nodemanager; do
    if [ -f "/etc/systemd/system/${svc}.service" ]; then
        check_and_count "check_systemd_service ${svc}" || true
    fi
done
echo ""

# ============================================================
# 总结
# ============================================================
echo "============================================"
echo "检查总结"
echo "============================================"
echo "总检查项: ${TOTAL}"
echo "通过: ${PASSED}"
echo "失败: ${FAILED}"
echo "通过率: $(( PASSED * 100 / TOTAL ))%"
echo "============================================"

if [ $FAILED -eq 0 ]; then
    echo "所有检查项通过！"
    exit 0
else
    echo "部分检查项未通过，请检查日志"
    exit 1
fi
