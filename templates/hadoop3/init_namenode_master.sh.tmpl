#!/bin/bash
# Hadoop 3 主 NameNode 初始化脚本
# 使用方法: bash init_namenode_master.sh
# 说明: 在主 NameNode 节点执行，完成以下步骤：
#   1. 格式化 NameNode（仅首次）
#   2. 初始化共享存储（可选）
#   3. 格式化 ZKFC（仅首次）
# 注意: 必须确保所有 JournalNode 已启动！
# 注意: 此脚本只执行初始化，不启动服务。启动服务请使用 systemctl 或 start_namenode.sh

set -e

# ============================================================
# 全局变量
# ============================================================
INSTALL_BASE_DIR="{{.Global.install_base_dir}}"
DATA_BASE_DIR="{{.Global.data_base_dir}}"
RUN_USER="{{.Global.user}}"
RUN_GROUP="{{.Global.group}}"
JAVA_HOME="{{.Global.java_home}}"

# ============================================================
# 辅助函数
# ============================================================
run_as_root() {
    if [ "$RUN_USER" = "root" ]; then
        "$@"
    else
        sudo "$@"
    fi
}

run_as_user() {
    if [ "$RUN_USER" = "root" ]; then
        "$@"
    else
        sudo -u ${RUN_USER} "$@"
    fi
}

log_info() {
    echo "[$(date '+%Y-%m-%d %H:%M:%S')] [INFO] $1"
}

log_error() {
    echo "[$(date '+%Y-%m-%d %H:%M:%S')] [ERROR] $1" >&2
}

log_warn() {
    echo "[$(date '+%Y-%m-%d %H:%M:%S')] [WARN] $1"
}

log_success() {
    echo "[$(date '+%Y-%m-%d %H:%M:%S')] [SUCCESS] $1"
}

check_port() {
    local host=$1
    local port=$2
    if timeout 5 bash -c "echo > /dev/tcp/${host}/${port}" 2>/dev/null; then
        return 0
    fi
    return 1
}

# ============================================================
# Hadoop 配置
# ============================================================
HADOOP_HOME="${INSTALL_BASE_DIR}/{{.Instance.Vars.install_subdir}}"
HADOOP_CONF_DIR="${HADOOP_HOME}/etc/hadoop"
NN_DATA_DIR="${DATA_BASE_DIR}/{{.Instance.Vars.namenode_data_subdir}}"
NAMESERVICE="{{.Instance.Vars.nameservice}}"
JN_PORT="{{.Instance.Vars.journalnode_port}}"
NN_RPC_PORT="{{.Instance.Vars.namenode_rpc_port}}"
NN_HTTP_PORT="{{.Instance.Vars.namenode_http_port}}"
SERVICE_NAME="hadoop-hdfs-namenode"

# ============================================================
# 开始初始化
# ============================================================
echo "============================================"
echo "Hadoop 3 主 NameNode 初始化脚本"
echo "============================================"
echo "主机名: $(hostname)"
echo "Nameservice: ${NAMESERVICE}"
echo "NameNode 数据目录: ${NN_DATA_DIR}"
echo "============================================"
echo ""
echo "注意: 此脚本只执行初始化操作（格式化），不启动服务。"
echo "      服务启动请使用: sudo systemctl start ${SERVICE_NAME}"
echo "============================================"

# 设置环境变量
export JAVA_HOME=${JAVA_HOME}
export HADOOP_HOME=${HADOOP_HOME}
export HADOOP_CONF_DIR=${HADOOP_CONF_DIR}
export HDFS_NAMENODE_USER=${RUN_USER}
export HDFS_DATANODE_USER=${RUN_USER}
export HDFS_JOURNALNODE_USER=${RUN_USER}
export HDFS_ZKFC_USER=${RUN_USER}
export YARN_RESOURCEMANAGER_USER=${RUN_USER}
export YARN_NODEMANAGER_USER=${RUN_USER}

PATH=${HADOOP_HOME}/bin:${HADOOP_HOME}/sbin:${PATH}

# ============================================================
# 步骤1: 检查前置条件
# ============================================================
log_info "步骤1: 检查前置条件..."

# 检查Hadoop安装
if [ ! -d "${HADOOP_HOME}" ]; then
    log_error "Hadoop未安装，请先执行 install_binary.sh"
    exit 1
fi

# 检查配置文件
if [ ! -f "${HADOOP_CONF_DIR}/hdfs-site.xml" ]; then
    log_error "配置文件不存在，请先执行 deploy_config.sh"
    exit 1
fi

# 检查数据目录
if [ ! -d "${NN_DATA_DIR}" ]; then
    log_error "数据目录不存在，请先执行 setup_dirs.sh"
    exit 1
fi

log_info "前置条件检查通过"

# ============================================================
# 步骤2: 检查 JournalNode 状态（关键！）
# ============================================================
log_info "步骤2: 检查 JournalNode 状态..."
log_warn "必须确保所有 JournalNode 已启动！"

JN_READY_COUNT=0
JN_TOTAL={{ len (serviceNodes "hadoop3/journalnode") }}

{{- range $i, $inst := (serviceNodes "hadoop3/journalnode") }}
log_info "检查 JournalNode: {{$inst.Node.Hostname}} ({{$inst.Node.IP}})"
if check_port "{{$inst.Node.IP}}" "${JN_PORT}"; then
    log_success "JournalNode {{$inst.Node.Hostname}} 可连接"
    JN_READY_COUNT=$((JN_READY_COUNT + 1))
else
    log_error "JournalNode {{$inst.Node.Hostname}} 无法连接"
fi
{{- end }}

log_info "JournalNode 就绪数量: ${JN_READY_COUNT}/${JN_TOTAL}"

if [ ${JN_READY_COUNT} -lt 1 ]; then
    log_error "没有可用的 JournalNode，请先启动所有 JournalNode"
    log_error "执行命令: bash start_journalnode.sh"
    exit 1
fi

# ============================================================
# 步骤3: 格式化 NameNode（仅首次执行）
# ============================================================
log_info "步骤3: 格式化 NameNode (仅主节点，仅首次)..."

# 检查是否已格式化
if [ -d "${NN_DATA_DIR}/current" ]; then
    log_warn "NameNode 已格式化，跳过格式化步骤"
    log_warn "如需重新格式化，请先清理数据目录: ${NN_DATA_DIR}"
    log_warn "警告: 重新格式化会丢失所有 HDFS 数据！"
else
    log_info "开始格式化 NameNode..."
    log_warn "注意：只格式化主节点！"
    
    # 格式化 NameNode
    run_as_user ${HADOOP_HOME}/bin/hdfs namenode -format ${NAMESERVICE} -force -nonInteractive
    
    if [ $? -eq 0 ]; then
        log_success "NameNode 格式化完成"
    else
        log_error "NameNode 格式化失败"
        exit 1
    fi
fi

# ============================================================
# 步骤4: 初始化共享存储 (initializeSharedEdits) - 可选
# ============================================================
log_info "步骤4: 初始化共享存储 (initializeSharedEdits)..."
log_info "注意: 此步骤通常在备节点加入时需要，主节点格式化后一般不需要"

# 检查是否需要在主节点执行
if [ -d "${NN_DATA_DIR}/current" ]; then
    log_info "NameNode 已格式化，跳过共享存储初始化"
else
    log_warn "如需初始化共享存储，请在主节点启动后，在备节点执行 bootstrapStandby"
fi

# ============================================================
# 步骤5: 格式化 ZKFC（仅首次执行）
# ============================================================
log_info "步骤5: 格式化 ZKFC..."
log_warn "此步骤在 ZooKeeper 中创建 /hadoop-ha 路径"
log_warn "注意：此步骤只需执行一次！"

# 检查 ZooKeeper 是否可用
log_info "检查 ZooKeeper 状态..."
ZK_READY=false

{{- range $i, $inst := (serviceNodes "zookeeper") }}
if check_port "{{$inst.Node.IP}}" "2181"; then
    log_info "ZooKeeper {{$inst.Node.Hostname}} 可连接"
    ZK_READY=true
fi
{{- end }}

if [ "$ZK_READY" = "false" ]; then
    log_error "无法连接到 ZooKeeper，请确保 ZooKeeper 已启动"
    exit 1
fi

# 检查是否已格式化 ZKFC
log_info "检查 ZKFC 是否已格式化..."
ZK_OUTPUT=$(run_as_user ${HADOOP_HOME}/bin/hdfs zkfc -formatZK -force -nonInteractive 2>&1) || true

if echo "$ZK_OUTPUT" | grep -q "is not empty"; then
    log_warn "ZKFC 已格式化，跳过"
elif echo "$ZK_OUTPUT" | grep -q "Successfully created"; then
    log_success "ZKFC 格式化完成"
else
    log_error "ZKFC 格式化失败:"
    echo "$ZK_OUTPUT"
    exit 1
fi

# ============================================================
# 步骤6: 部署 systemd 服务文件
# ============================================================
log_info "步骤6: 部署 systemd 服务文件..."

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
SERVICE_FILE="${SCRIPT_DIR}/systemd/${SERVICE_NAME}.service"

if [ ! -f "${SERVICE_FILE}" ]; then
    log_error "未找到 systemd 服务文件: ${SERVICE_FILE}"
    exit 1
fi

# 部署服务文件
run_as_root cp "${SERVICE_FILE}" /etc/systemd/system/
run_as_root chmod 644 /etc/systemd/system/${SERVICE_NAME}.service
run_as_root systemctl daemon-reload
run_as_root systemctl enable ${SERVICE_NAME}
log_success "systemd 服务文件已部署并启用"

# ============================================================
# 初始化完成
# ============================================================
echo ""
echo "============================================"
echo "主 NameNode 初始化完成！"
echo "============================================"
echo ""
echo "初始化内容:"
echo "  - NameNode 格式化: 完成（如未格式化过）"
echo "  - ZKFC 格式化: 完成（如未格式化过）"
echo "  - systemd 服务: 已部署并启用"
echo ""
echo "重要: 此脚本只执行了初始化，NameNode 服务尚未启动！"
echo ""
echo "启动 NameNode 服务:"
echo "  sudo systemctl start ${SERVICE_NAME}"
echo ""
echo "管理命令:"
echo "  查看状态: sudo systemctl status ${SERVICE_NAME}"
echo "  停止服务: sudo systemctl stop ${SERVICE_NAME}"
echo "  查看日志: sudo journalctl -u ${SERVICE_NAME} -f"
echo ""
echo "Web UI: http://$(hostname):${NN_HTTP_PORT}"
echo ""
echo "检查状态:"
echo "  jps | grep NameNode"
echo ""
echo "后续步骤:"
echo "1. 启动 NameNode: sudo systemctl start ${SERVICE_NAME}"
echo "2. 在备 NameNode 节点执行: bash init_namenode_standby.sh"
echo "3. 在所有 NameNode 节点启动 ZKFC: bash start_zkfc.sh"
echo "4. 在所有 DataNode 节点启动 DataNode: bash start_datanode.sh"
