#!/bin/bash
# Hadoop 3 JournalNode 启动脚本
# 使用方法: bash start.sh
# 说明: 启动JournalNode服务（第一个启动的HDFS组件）

set -e

# ============================================================
# 全局变量
# ============================================================
INSTALL_BASE_DIR="{{.Global.install_base_dir}}"
RUN_USER="{{.Global.user}}"
JAVA_HOME="{{.Global.java_home}}"

# ============================================================
# 辅助函数
# ============================================================
run_as_root() {
    if [ "$RUN_USER" = "root" ]; then
        "$@"
    else
        sudo "$@"
    fi
}

log_info() {
    echo "[$(date '+%Y-%m-%d %H:%M:%S')] [INFO] $1"
}

log_error() {
    echo "[$(date '+%Y-%m-%d %H:%M:%S')] [ERROR] $1" >&2
}

log_success() {
    echo "[$(date '+%Y-%m-%d %H:%M:%S')] [SUCCESS] $1"
}

# ============================================================
# 配置
# ============================================================
HADOOP_HOME="${INSTALL_BASE_DIR}/{{.Instance.Vars.install_subdir}}"
HADOOP_CONF_DIR="${HADOOP_HOME}/etc/hadoop"
PID_FILE="${HADOOP_HOME}/pids/hadoop-hdfs-journalnode.pid"

# ============================================================
# 开始启动
# ============================================================
echo "============================================"
echo "Hadoop 3 JournalNode 启动脚本"
echo "============================================"
echo "主机名: $(hostname)"
echo "============================================"

# 设置环境变量
export JAVA_HOME=${JAVA_HOME}
export HADOOP_HOME=${HADOOP_HOME}
export HADOOP_CONF_DIR=${HADOOP_CONF_DIR}
export HDFS_JOURNALNODE_USER=${RUN_USER}

PATH=${HADOOP_HOME}/bin:${HADOOP_HOME}/sbin:${PATH}

# ============================================================
# 检查是否已运行
# ============================================================
log_info "检查 JournalNode 状态..."
if [ -f "${PID_FILE}" ]; then
    PID=$(cat "${PID_FILE}")
    if ps -p ${PID} > /dev/null 2>&1; then
        log_info "JournalNode 已在运行 (PID: ${PID})"
        exit 0
    else
        log_info "清理残留 PID 文件"
        rm -f "${PID_FILE}"
    fi
fi

# ============================================================
# 检查前置条件
# ============================================================
log_info "检查前置条件..."

# 检查Hadoop安装
if [ ! -d "${HADOOP_HOME}" ]; then
    log_error "Hadoop未安装"
    exit 1
fi

# 检查配置文件
if [ ! -f "${HADOOP_CONF_DIR}/hdfs-site.xml" ]; then
    log_error "配置文件不存在"
    exit 1
fi

# 检查数据目录
JN_DATA_DIR="{{.Global.data_base_dir}}/{{.Instance.Vars.journalnode_data_subdir}}"
if [ ! -d "${JN_DATA_DIR}" ]; then
    log_error "数据目录不存在，请先执行 install.sh"
    exit 1
fi

log_info "前置条件检查通过"

# ============================================================
# 启动服务
# ============================================================
log_info "启动 JournalNode..."

# 使用 hadoop-daemon.sh 启动
${HADOOP_HOME}/sbin/hadoop-daemon.sh --config ${HADOOP_CONF_DIR} --script hdfs start journalnode

# 等待启动
sleep 3

# 验证
if [ -f "${PID_FILE}" ]; then
    PID=$(cat "${PID_FILE}")
    if ps -p ${PID} > /dev/null 2>&1; then
        log_success "JournalNode 启动成功 (PID: ${PID})"
    else
        log_error "JournalNode 启动失败"
        exit 1
    fi
else
    log_error "JournalNode PID 文件未创建"
    exit 1
fi

# ============================================================
# 检查端口
# ============================================================
log_info "检查端口监听..."
sleep 2

if netstat -tuln 2>/dev/null | grep -q ":8485 " || ss -tuln 2>/dev/null | grep -q ":8485 "; then
    log_success "端口 8485 正在监听"
else
    log_warn "端口 8485 未监听，请检查日志"
fi

# ============================================================
# 启动完成
# ============================================================
echo ""
echo "============================================"
echo "JournalNode 启动完成！"
echo "============================================"
echo ""
echo "检查状态:"
echo "  jps | grep JournalNode"
echo "  systemctl status hadoop-hdfs-journalnode"
echo ""
echo "日志文件:"
echo "  ${HADOOP_HOME}/logs/hadoop-${RUN_USER}-journalnode-$(hostname).log"
