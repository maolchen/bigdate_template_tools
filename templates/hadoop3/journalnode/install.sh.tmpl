#!/bin/bash
# Hadoop JournalNode 安装脚本
# 使用方法: bash install.sh

set -e

# ============================================================
# 全局变量
# ============================================================
INSTALL_BASE_DIR="{{.Global.install_base_dir}}"
DATA_BASE_DIR="{{.Global.data_base_dir}}"
PKG_PRO_DIR="{{.Global.pkg_pro_dir}}"
RUN_USER="{{.Global.user}}"
RUN_GROUP="{{.Global.group}}"

# ============================================================
# 用户权限判断（符合规范5）
# ============================================================
if [ "$RUN_USER" = "root" ]; then
    SUDO_CMD=""
else
    SUDO_CMD="sudo"
fi

# 辅助函数：以root权限执行命令
run_as_root() {
    if [ "$RUN_USER" = "root" ]; then
        "$@"
    else
        sudo "$@"
    fi
}

# ============================================================
# JournalNode配置
# ============================================================
HADOOP_INSTALL_DIR="${INSTALL_BASE_DIR}/{{.Instance.Vars.install_subdir}}"
JOURNALNODE_DATA_DIR="${DATA_BASE_DIR}/{{.Instance.Vars.journalnode_data_subdir}}"

# ============================================================
# 创建目录
# ============================================================
echo "创建JournalNode数据目录..."
run_as_root mkdir -p "${JOURNALNODE_DATA_DIR}"
run_as_root mkdir -p "${DATA_BASE_DIR}/{{.Instance.Vars.install_subdir}}/logs"
run_as_root mkdir -p "${DATA_BASE_DIR}/{{.Instance.Vars.install_subdir}}/pids"

# ============================================================
# 设置权限（符合规范6）
# ============================================================
echo "设置JournalNode目录权限..."
run_as_root chown -R ${RUN_USER}:${RUN_GROUP} "${JOURNALNODE_DATA_DIR}"

echo "Hadoop JournalNode 安装准备完成！"
echo "数据目录: ${JOURNALNODE_DATA_DIR}"
echo "请确保Hadoop已安装在: ${HADOOP_INSTALL_DIR}"
echo "运行用户: ${RUN_USER}"
