#!/bin/bash
# Hadoop 3 ZKFC 服务启动脚本
# 使用方法: bash start.sh [--format]
#   --format  格式化ZKFC（首次启动时使用，仅第一个NameNode）
# 参考: tmp/hadoop3/tasks/05_service_startup.yml

set -e

# ============================================================
# 全局变量（遵循 GLOBAL_VARS_GUIDE.md 规范）
# ============================================================
INSTALL_BASE_DIR="{{.Global.install_base_dir}}"
DATA_BASE_DIR="{{.Global.data_base_dir}}"
RUN_USER="{{.Global.user}}"
RUN_GROUP="{{.Global.group}}"
JAVA_HOME="{{.Global.java_home}}"

# ============================================================
# 辅助函数
# ============================================================
run_as_root() {
    if [ "$RUN_USER" = "root" ]; then
        "$@"
    else
        sudo "$@"
    fi
}

run_as_user() {
    if [ "$RUN_USER" = "root" ]; then
        "$@"
    else
        sudo -u ${RUN_USER} "$@"
    fi
}

log_info() {
    echo "[$(date '+%Y-%m-%d %H:%M:%S')] [INFO] $1"
}

log_error() {
    echo "[$(date '+%Y-%m-%d %H:%M:%S')] [ERROR] $1" >&2
}

log_warn() {
    echo "[$(date '+%Y-%m-%d %H:%M:%S')] [WARN] $1"
}

is_process_running() {
    pgrep -f "$1" > /dev/null 2>&1
}

check_port() {
    local host="$1"
    local port="$2"
    timeout 5 bash -c "echo > /dev/tcp/${host}/${port}" 2>/dev/null
}

# ============================================================
# Hadoop 配置
# ============================================================
HADOOP_HOME="${INSTALL_BASE_DIR}/{{.Instance.Vars.install_subdir}}"
NAMESERVICE="{{.Instance.Vars.nameservice}}"

# 获取当前节点是否为第一个NameNode
{{- $current_namenode_id := .Instance.AutoID }}
{{- range $i, $inst := (serviceNodes "hadoop3/namenode") }}
{{- if eq $inst.AutoID $current_namenode_id }}
{{- if eq $i 0 }}
IS_FIRST_NAMENODE=true
{{- else }}
IS_FIRST_NAMENODE=false
{{- end }}
{{- end }}
{{- end }}

# ============================================================
# 参数解析
# ============================================================
FORMAT_ZK=false

while [[ $# -gt 0 ]]; do
    case $1 in
        --format)
            FORMAT_ZK=true
            shift
            ;;
        *)
            log_error "未知参数: $1"
            echo "使用方法: bash start.sh [--format]"
            exit 1
            ;;
    esac
done

# ============================================================
# 开始启动
# ============================================================
echo "============================================"
echo "Hadoop 3 ZKFC 服务启动脚本"
echo "============================================"
echo "主机名: $(hostname)"
echo "Nameservice: ${NAMESERVICE}"
echo "HADOOP_HOME: ${HADOOP_HOME}"
echo "是否为第一个NameNode: ${IS_FIRST_NAMENODE:-false}"
echo "格式化ZKFC: ${FORMAT_ZK}"
echo "运行用户: ${RUN_USER}"
echo "============================================"

# 设置环境变量
export JAVA_HOME=${JAVA_HOME}
export HADOOP_HOME=${HADOOP_HOME}
export HADOOP_CONF_DIR=${HADOOP_HOME}/etc/hadoop
export PATH=${PATH}:${HADOOP_HOME}/bin:${HADOOP_HOME}/sbin

# ============================================================
# 步骤1: 检查前置条件
# ============================================================
log_info "步骤1: 检查前置条件..."

if [ ! -d "${HADOOP_HOME}" ]; then
    log_error "Hadoop未安装，请先执行 install.sh"
    exit 1
fi

if [ ! -f "${HADOOP_CONF_DIR}/hdfs-site.xml" ]; then
    log_error "配置文件不存在，请先执行 deploy_config.sh"
    exit 1
fi

log_info "前置条件检查通过"

# ============================================================
# 步骤2: 检查 ZooKeeper 状态
# ============================================================
log_info "步骤2: 检查 ZooKeeper 状态..."

ZK_READY=false
ZK_PORT=2181

{{- range $i, $inst := (serviceNodes "zookeeper") }}
if check_port "{{$inst.Node.IP}}" "${ZK_PORT}"; then
    log_info "ZooKeeper {{$inst.Node.Hostname}}:{{$inst.Node.IP}}:${ZK_PORT} 可连接"
    ZK_READY=true
fi
{{- end }}

if [ "$ZK_READY" = "false" ]; then
    log_error "无法连接到任何 ZooKeeper 节点"
    log_error "请确保 ZooKeeper 集群已启动"
    exit 1
fi

# ============================================================
# 步骤3: 格式化 ZKFC（仅第一个NameNode，首次启动）
# ============================================================
if [ "$FORMAT_ZK" = "true" ] && [ "${IS_FIRST_NAMENODE:-false}" = "true" ]; then
    log_info "步骤3: 格式化 ZKFC..."
    log_warn "此操作只需要在一个 NameNode 上执行一次"
    
    # 执行格式化
    echo "yes" | run_as_user ${HADOOP_HOME}/bin/hdfs zkfc -formatZK
    log_info "ZKFC 格式化完成"
else
    log_info "步骤3: 跳过 ZKFC 格式化"
fi

# ============================================================
# 步骤4: 检查是否已运行
# ============================================================
log_info "步骤4: 检查服务状态..."

if is_process_running "org.apache.hadoop.hdfs.tools.DFSZKFailoverController"; then
    log_info "ZKFC 已在运行中"
    echo "进程ID: $(pgrep -f 'DFSZKFailoverController')"
    exit 0
fi

# ============================================================
# 步骤5: 启动 ZKFC
# ============================================================
log_info "步骤5: 启动 ZKFC..."

cd ${HADOOP_HOME}
run_as_user ${HADOOP_HOME}/bin/hdfs --daemon start zkfc

sleep 5

# ============================================================
# 步骤6: 验证启动
# ============================================================
log_info "步骤6: 验证启动..."

if is_process_running "org.apache.hadoop.hdfs.tools.DFSZKFailoverController"; then
    PID=$(pgrep -f 'org.apache.hadoop.hdfs.tools.DFSZKFailoverController')
    log_info "ZKFC 启动成功 (PID: ${PID})"
else
    log_error "ZKFC 启动失败"
    log_error "请检查日志: ${HADOOP_HOME}/logs/hadoop-*-zkfc-*.log"
    exit 1
fi

# ============================================================
# 步骤7: 检查 HA 状态
# ============================================================
log_info "步骤7: 检查 HA 状态..."
sleep 3

# 显示所有 NameNode 状态
echo ""
echo "NameNode HA 状态:"
{{- range $i, $inst := (serviceNodes "hadoop3/namenode") }}
STATE=$(${HADOOP_HOME}/bin/hdfs haadmin -getServiceState "{{$inst.AutoID}}" 2>/dev/null || echo "未知")
echo "  {{$inst.AutoID}} ({{$inst.Node.Hostname}}): ${STATE}"
{{- end }}

# ============================================================
# 启动完成
# ============================================================
echo ""
echo "============================================"
echo "ZKFC 启动完成！"
echo "============================================"
echo "进程ID: ${PID}"
echo ""
echo "提示: ZKFC 会自动监控 NameNode 状态并实现故障转移"
