#!/bin/bash
# Hadoop 3 服务初始化脚本
# 使用方法: bash init_services.sh [--skip-journalnode] [--skip-format]
# 说明: 在NameNode节点执行，初始化HDFS和YARN服务
# 注意: 
#   1. JournalNode必须先启动
#   2. 必须按顺序格式化和启动NameNode
#   3. ZKFC格式化仅执行一次
# 参考: tmp/hadoop3/tasks/05_startup.yml

set -e

# ============================================================
# 全局变量（遵循 GLOBAL_VARS_GUIDE.md 规范）
# ============================================================
INSTALL_BASE_DIR="{{.Global.install_base_dir}}"
DATA_BASE_DIR="{{.Global.data_base_dir}}"
RUN_USER="{{.Global.user}}"
RUN_GROUP="{{.Global.group}}"
JAVA_HOME="{{.Global.java_home}}"

# ============================================================
# 辅助函数
# ============================================================
run_as_root() {
    if [ "$RUN_USER" = "root" ]; then
        "$@"
    else
        sudo "$@"
    fi
}

log_info() {
    echo "[$(date '+%Y-%m-%d %H:%M:%S')] [INFO] $1"
}

log_error() {
    echo "[$(date '+%Y-%m-%d %H:%M:%S')] [ERROR] $1" >&2
}

log_warn() {
    echo "[$(date '+%Y-%m-%d %H:%M:%S')] [WARN] $1"
}

log_success() {
    echo "[$(date '+%Y-%m-%d %H:%M:%S')] [SUCCESS] $1"
}

check_process() {
    local pid_file="$1"
    if [ -f "${pid_file}" ]; then
        local pid=$(cat "${pid_file}")
        if ps -p ${pid} > /dev/null 2>&1; then
            return 0
        fi
    fi
    return 1
}

wait_for_service() {
    local service_name="$1"
    local max_wait="$2"
    local check_cmd="$3"
    
    log_info "等待 ${service_name} 启动 (最多 ${max_wait} 秒)..."
    
    local count=0
    while [ $count -lt $max_wait ]; do
        if eval "$check_cmd" > /dev/null 2>&1; then
            log_success "${service_name} 已就绪"
            return 0
        fi
        sleep 1
        count=$((count + 1))
    done
    
    log_error "${service_name} 启动超时"
    return 1
}

# ============================================================
# Hadoop 配置
# ============================================================
HADOOP_HOME="${INSTALL_BASE_DIR}/{{.Instance.Vars.install_subdir}}"
NAMESERVICE="{{.Instance.Vars.nameservice}}"
HADOOP_CONF_DIR="${HADOOP_HOME}/etc/hadoop"
LOG_DIR="${HADOOP_HOME}/logs"
PID_DIR="${HADOOP_HOME}/pids"

# 当前节点信息
CURRENT_HOSTNAME=$(hostname -f)
NAMENODE_ID="{{.Instance.Vars.nn_id}}"

{{- if eq (index .Instance.Vars.nn_id 0 0) "nn1" }}
# 第一个NameNode（Master）
IS_MASTER=true
{{- else }}
# 第二个NameNode（Standby）
IS_MASTER=false
{{- end }}

# ============================================================
# 参数解析
# ============================================================
SKIP_JOURNALNODE=false
SKIP_FORMAT=false

while [[ $# -gt 0 ]]; do
    case $1 in
        --skip-journalnode)
            SKIP_JOURNALNODE=true
            shift
            ;;
        --skip-format)
            SKIP_FORMAT=true
            shift
            ;;
        *)
            log_error "未知参数: $1"
            echo "使用方法: bash init_services.sh [--skip-journalnode] [--skip-format]"
            exit 1
            ;;
    esac
done

# ============================================================
# 开始初始化
# ============================================================
echo "============================================"
echo "Hadoop 3 服务初始化脚本"
echo "============================================"
echo "主机名: ${CURRENT_HOSTNAME}"
echo "NameNode ID: ${NAMENODE_ID}"
echo "角色: $([ "$IS_MASTER" = "true" ] && echo "Master (主节点)" || echo "Standby (备节点)")"
echo "Nameservice: ${NAMESERVICE}"
echo "跳过JournalNode启动: ${SKIP_JOURNALNODE}"
echo "跳过格式化: ${SKIP_FORMAT}"
echo "============================================"

# 设置环境变量
export JAVA_HOME=${JAVA_HOME}
export HADOOP_HOME=${HADOOP_HOME}
export HADOOP_CONF_DIR=${HADOOP_CONF_DIR}
export HDFS_NAMENODE_USER=${RUN_USER}
export HDFS_DATANODE_USER=${RUN_USER}
export HDFS_JOURNALNODE_USER=${RUN_USER}
export HDFS_ZKFC_USER=${RUN_USER}
export YARN_RESOURCEMANAGER_USER=${RUN_USER}
export YARN_NODEMANAGER_USER=${RUN_USER}

PATH=${HADOOP_HOME}/bin:${HADOOP_HOME}/sbin:${PATH}

# ============================================================
# 步骤1: 检查前置条件
# ============================================================
log_info "步骤1: 检查前置条件..."

# 检查Hadoop安装
if [ ! -d "${HADOOP_HOME}" ]; then
    log_error "Hadoop未安装，请先执行 install_binary.sh"
    exit 1
fi

# 检查配置文件
if [ ! -f "${HADOOP_CONF_DIR}/core-site.xml" ]; then
    log_error "配置文件不存在，请先执行 deploy_config.sh"
    exit 1
fi

# 检查数据目录
if [ ! -d "${DATA_BASE_DIR}/dfs/nn" ]; then
    log_error "数据目录不存在，请先执行 setup_dirs.sh"
    exit 1
fi

log_info "前置条件检查通过"

# ============================================================
# 步骤2: 安装并启动 JournalNode
# ============================================================
if [ "$SKIP_JOURNALNODE" = "false" ]; then
    log_info "步骤2: 检查 JournalNode 状态..."
    
    # 检查JournalNode是否已启动
    JN_PID_FILE="${PID_DIR}/hadoop-hdfs-journalnode.pid"
    
    if check_process "${JN_PID_FILE}"; then
        log_info "JournalNode已在运行 (PID: $(cat ${JN_PID_FILE}))"
    else
        log_warn "JournalNode未运行"
        log_warn "请确保 JournalNode 已在其他节点启动并运行"
        log_warn "JournalNode 启动命令: systemctl start hadoop-hdfs-journalnode"
        
        # 等待JournalNode可用
        JN_READY=false
        for jn_host in $(echo "{{join (serviceEndpoints "hadoop3/journalnode" "hostname") ","}}" | tr ',' ' '); do
            log_info "检查 JournalNode: ${jn_host}"
            if timeout 5 bash -c "echo > /dev/tcp/${jn_host}/8485" 2>/dev/null; then
                JN_READY=true
                log_success "JournalNode ${jn_host} 可用"
                break
            fi
        done
        
        if [ "$JN_READY" = "false" ]; then
            log_error "没有可用的 JournalNode，请先启动 JournalNode"
            exit 1
        fi
    fi
else
    log_info "步骤2: 跳过 JournalNode 检查"
fi

# ============================================================
# 步骤3: 格式化并启动 NameNode
# ============================================================
log_info "步骤3: 初始化 NameNode..."

NN_DATA_DIR="${DATA_BASE_DIR}/dfs/nn"
NN_PID_FILE="${PID_DIR}/hadoop-hdfs-namenode.pid"

# 检查NameNode是否已运行
if check_process "${NN_PID_FILE}"; then
    log_info "NameNode已在运行 (PID: $(cat ${NN_PID_FILE}))"
elif [ "$SKIP_FORMAT" = "true" ]; then
    log_info "跳过格式化，直接启动NameNode"
    ${HADOOP_HOME}/sbin/hadoop-daemon.sh --config ${HADOOP_CONF_DIR} --script hdfs start namenode
else
    # 检查是否已格式化
    if [ -d "${NN_DATA_DIR}/current" ]; then
        log_info "NameNode已格式化，直接启动"
        ${HADOOP_HOME}/sbin/hadoop-daemon.sh --config ${HADOOP_CONF_DIR} --script hdfs start namenode
    else
        if [ "$IS_MASTER" = "true" ]; then
            log_info "格式化 NameNode (Master)..."
            ${HADOOP_HOME}/bin/hdfs namenode -format ${NAMESERVICE} -force -nonInteractive
            log_success "NameNode 格式化完成"
        else
            log_info "同步 NameNode (Standby) 数据..."
            ${HADOOP_HOME}/bin/hdfs namenode -bootstrapStandby -force -nonInteractive
            log_success "NameNode 数据同步完成"
        fi
        
        # 启动NameNode
        log_info "启动 NameNode..."
        ${HADOOP_HOME}/sbin/hadoop-daemon.sh --config ${HADOOP_CONF_DIR} --script hdfs start namenode
    fi
fi

# 等待NameNode启动
wait_for_service "NameNode" 60 "curl -s http://localhost:9870 | grep -q 'NameNode'"

# ============================================================
# 步骤4: 格式化并启动 ZKFC
# ============================================================
log_info "步骤4: 初始化 ZKFC..."

ZKFC_PID_FILE="${PID_DIR}/hadoop-hdfs-zkfc.pid"

# 检查ZKFC是否已运行
if check_process "${ZKFC_PID_FILE}"; then
    log_info "ZKFC已在运行 (PID: $(cat ${ZKFC_PID_FILE}))"
else
    # 仅在Master节点且未格式化时执行ZKFC格式化
    if [ "$IS_MASTER" = "true" ] && [ "$SKIP_FORMAT" = "false" ]; then
        # 检查是否已格式化
        ZK_FORMATTED=false
        if zkCli.sh ls /hadoop-ha/${NAMESERVICE} 2>/dev/null | grep -q "Leader"; then
            ZK_FORMATTED=true
        fi
        
        if [ "$ZK_FORMATTED" = "false" ]; then
            log_info "格式化 ZKFC (仅执行一次)..."
            ${HADOOP_HOME}/bin/hdfs zkfc -formatZK -force
            log_success "ZKFC 格式化完成"
        fi
    fi
    
    # 启动ZKFC
    log_info "启动 ZKFC..."
    ${HADOOP_HOME}/sbin/hadoop-daemon.sh --config ${HADOOP_CONF_DIR} --script hdfs start zkfc
fi

# 等待ZKFC启动
sleep 3
if check_process "${ZKFC_PID_FILE}"; then
    log_success "ZKFC 已启动"
else
    log_error "ZKFC 启动失败"
    exit 1
fi

# ============================================================
# 步骤5: 验证 HDFS 状态
# ============================================================
log_info "步骤5: 验证 HDFS 状态..."

# 检查NameNode状态
NN_STATE=$(${HADOOP_HOME}/bin/hdfs haadmin -getAllServiceState 2>/dev/null || echo "未知")
log_info "NameNode 状态:"
echo "${NN_STATE}"

# 检查HDFS是否可用
sleep 5
if ${HADOOP_HOME}/bin/hdfs dfsadmin -safemode get 2>/dev/null | grep -q "OFF"; then
    log_success "HDFS 已就绪，退出安全模式"
else
    log_warn "HDFS 可能仍在安全模式或启动中"
fi

# ============================================================
# 步骤6: 验证 HDFS 高可用
# ============================================================
if [ "$IS_MASTER" = "true" ]; then
    log_info "步骤6: 验证 HDFS 高可用..."
    
    # 等待两个NameNode都启动
    sleep 10
    
    # 检查Active/Standby状态
    NN1_STATE=$(${HADOOP_HOME}/bin/hdfs haadmin -getServiceState nn1 2>/dev/null || echo "未知")
    NN2_STATE=$(${HADOOP_HOME}/bin/hdfs haadmin -getServiceState nn2 2>/dev/null || echo "未知")
    
    log_info "nn1 状态: ${NN1_STATE}"
    log_info "nn2 状态: ${NN2_STATE}"
    
    if [ "$NN1_STATE" = "active" ] || [ "$NN2_STATE" = "active" ]; then
        log_success "HDFS 高可用配置正常，检测到 Active NameNode"
    else
        log_warn "未检测到 Active NameNode，请检查日志"
    fi
fi

# ============================================================
# 初始化完成
# ============================================================
echo ""
echo "============================================"
echo "Hadoop 3 服务初始化完成！"
echo "============================================"
echo ""
echo "服务状态:"
echo "  NameNode: $(check_process "${NN_PID_FILE}" && echo "运行中" || echo "未运行")"
echo "  ZKFC: $(check_process "${ZKFC_PID_FILE}" && echo "运行中" || echo "未运行")"
echo ""
echo "Web UI:"
echo "  NameNode: http://${CURRENT_HOSTNAME}:9870"
echo ""
echo "后续步骤:"
echo "1. 在其他NameNode节点执行此脚本"
echo "2. 启动DataNode: systemctl start hadoop-hdfs-datanode"
echo "3. 启动YARN: systemctl start hadoop-yarn-resourcemanager"
echo ""
echo "注意: 如需配置开机自启，请执行:"
echo "  systemctl enable hadoop-hdfs-namenode"
echo "  systemctl enable hadoop-hdfs-zkfc"
