#!/bin/bash
# Hadoop 3 DataNode 服务启动脚本
# 使用方法: bash start.sh
# 参考: tmp/hadoop3/tasks/05_service_startup.yml

set -e

# ============================================================
# 全局变量（遵循 GLOBAL_VARS_GUIDE.md 规范）
# ============================================================
INSTALL_BASE_DIR="{{.Global.install_base_dir}}"
DATA_BASE_DIR="{{.Global.data_base_dir}}"
RUN_USER="{{.Global.user}}"
RUN_GROUP="{{.Global.group}}"
JAVA_HOME="{{.Global.java_home}}"

# ============================================================
# 辅助函数
# ============================================================
run_as_root() {
    if [ "$RUN_USER" = "root" ]; then
        "$@"
    else
        sudo "$@"
    fi
}

run_as_user() {
    if [ "$RUN_USER" = "root" ]; then
        "$@"
    else
        sudo -u ${RUN_USER} "$@"
    fi
}

log_info() {
    echo "[$(date '+%Y-%m-%d %H:%M:%S')] [INFO] $1"
}

log_error() {
    echo "[$(date '+%Y-%m-%d %H:%M:%S')] [ERROR] $1" >&2
}

log_warn() {
    echo "[$(date '+%Y-%m-%d %H:%M:%S')] [WARN] $1"
}

is_process_running() {
    pgrep -f "$1" > /dev/null 2>&1
}

check_port() {
    local host="$1"
    local port="$2"
    timeout 5 bash -c "echo > /dev/tcp/${host}/${port}" 2>/dev/null
}

# ============================================================
# Hadoop 配置
# ============================================================
HADOOP_HOME="${INSTALL_BASE_DIR}/{{.Instance.Vars.install_subdir}}"
DATANODE_DATA_DIR="${DATA_BASE_DIR}/{{.Instance.Vars.datanode_data_subdir}}"
DATANODE_DATA_PORT="{{.Instance.Vars.datanode_data_port}}"
DATANODE_HTTP_PORT="{{.Instance.Vars.datanode_http_port}}"
SOCKETS_DIR="${DATA_BASE_DIR}/{{.Instance.Vars.install_subdir}}/hdfs-sockets"

# ============================================================
# 开始启动
# ============================================================
echo "============================================"
echo "Hadoop 3 DataNode 服务启动脚本"
echo "============================================"
echo "主机名: $(hostname)"
echo "HADOOP_HOME: ${HADOOP_HOME}"
echo "数据目录: ${DATANODE_DATA_DIR}"
echo "数据端口: ${DATANODE_DATA_PORT}"
echo "HTTP端口: ${DATANODE_HTTP_PORT}"
echo "运行用户: ${RUN_USER}"
echo "============================================"

# 设置环境变量
export JAVA_HOME=${JAVA_HOME}
export HADOOP_HOME=${HADOOP_HOME}
export HADOOP_CONF_DIR=${HADOOP_HOME}/etc/hadoop
export PATH=${PATH}:${HADOOP_HOME}/bin:${HADOOP_HOME}/sbin

# ============================================================
# 步骤1: 检查前置条件
# ============================================================
log_info "步骤1: 检查前置条件..."

if [ ! -d "${HADOOP_HOME}" ]; then
    log_error "Hadoop未安装，请先执行 install.sh"
    exit 1
fi

if [ ! -f "${HADOOP_CONF_DIR}/hdfs-site.xml" ]; then
    log_error "配置文件不存在，请先执行 deploy_config.sh"
    exit 1
fi

log_info "前置条件检查通过"

# ============================================================
# 步骤2: 检查 NameNode 状态
# ============================================================
log_info "步骤2: 检查 NameNode 状态..."

NAMENODE_RPC_PORT="{{.Instance.Vars.namenode_rpc_port}}"
NN_READY=false

{{- range $i, $inst := (serviceNodes "hadoop3/namenode") }}
if check_port "{{$inst.Node.IP}}" "${NAMENODE_RPC_PORT}"; then
    log_info "NameNode {{$inst.Node.Hostname}}:{{$inst.Node.IP}}:${NAMENODE_RPC_PORT} 可连接"
    NN_READY=true
fi
{{- end }}

if [ "$NN_READY" = "false" ]; then
    log_warn "无法连接到任何 NameNode"
    log_warn "请确保 NameNode 已启动并处于 Active 状态"
    read -p "是否继续启动 DataNode? (y/n): " CONTINUE
    if [ "$CONTINUE" != "y" ]; then
        log_info "启动已取消"
        exit 0
    fi
fi

# ============================================================
# 步骤3: 准备数据目录
# ============================================================
log_info "步骤3: 准备数据目录..."

if [ ! -d "${DATANODE_DATA_DIR}" ]; then
    run_as_root mkdir -p "${DATANODE_DATA_DIR}"
    run_as_root chown -R ${RUN_USER}:${RUN_GROUP} "${DATANODE_DATA_DIR}"
    log_info "数据目录已创建: ${DATANODE_DATA_DIR}"
else
    log_info "数据目录已存在: ${DATANODE_DATA_DIR}"
fi

# 创建短路读取 socket 目录
if [ ! -d "${SOCKETS_DIR}/dn" ]; then
    run_as_root mkdir -p "${SOCKETS_DIR}/dn"
    run_as_root chown -R ${RUN_USER}:${RUN_GROUP} "${SOCKETS_DIR}/dn"
    run_as_root chmod 755 "${SOCKETS_DIR}/dn"
    log_info "Socket目录已创建: ${SOCKETS_DIR}/dn"
fi

# ============================================================
# 步骤4: 检查是否已运行
# ============================================================
log_info "步骤4: 检查服务状态..."

if is_process_running "org.apache.hadoop.hdfs.server.datanode.DataNode"; then
    log_info "DataNode 已在运行中"
    echo "进程ID: $(pgrep -f 'DataNode')"
    exit 0
fi

# ============================================================
# 步骤5: 启动 DataNode
# ============================================================
log_info "步骤5: 启动 DataNode..."

cd ${HADOOP_HOME}
run_as_user ${HADOOP_HOME}/bin/hdfs --daemon start datanode

sleep 10

# ============================================================
# 步骤6: 验证启动
# ============================================================
log_info "步骤6: 验证启动..."

if is_process_running "org.apache.hadoop.hdfs.server.datanode.DataNode"; then
    PID=$(pgrep -f 'org.apache.hadoop.hdfs.server.datanode.DataNode')
    log_info "DataNode 启动成功 (PID: ${PID})"
else
    log_error "DataNode 启动失败"
    log_error "请检查日志: ${HADOOP_HOME}/logs/hadoop-*-datanode-*.log"
    exit 1
fi

# 检查端口
if check_port "localhost" "${DATANODE_DATA_PORT}"; then
    log_info "数据端口 ${DATANODE_DATA_PORT} 正在监听"
else
    log_warn "数据端口 ${DATANODE_DATA_PORT} 未监听"
fi

if check_port "localhost" "${DATANODE_HTTP_PORT}"; then
    log_info "HTTP端口 ${DATANODE_HTTP_PORT} 正在监听"
fi

# ============================================================
# 启动完成
# ============================================================
echo ""
echo "============================================"
echo "DataNode 启动完成！"
echo "============================================"
echo "进程ID: ${PID}"
echo "数据目录: ${DATANODE_DATA_DIR}"
echo "监听端口: ${DATANODE_DATA_PORT} (数据), ${DATANODE_HTTP_PORT} (HTTP)"
echo ""
echo "验证命令（在 NameNode 节点执行）:"
echo "  hdfs dfsadmin -report"
