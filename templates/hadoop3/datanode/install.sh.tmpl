#!/bin/bash
# Hadoop 3 DataNode 服务脚本
# 使用方法: bash install.sh
# 说明: 在DataNode节点执行，准备DataNode运行环境

set -e

# ============================================================
# 全局变量
# ============================================================
INSTALL_BASE_DIR="{{.Global.install_base_dir}}"
DATA_BASE_DIR="{{.Global.data_base_dir}}"
RUN_USER="{{.Global.user}}"
RUN_GROUP="{{.Global.group}}"
JAVA_HOME="{{.Global.java_home}}"

# ============================================================
# 辅助函数
# ============================================================
run_as_root() {
    if [ "$RUN_USER" = "root" ]; then
        "$@"
    else
        sudo "$@"
    fi
}

log_info() {
    echo "[$(date '+%Y-%m-%d %H:%M:%S')] [INFO] $1"
}

log_error() {
    echo "[$(date '+%Y-%m-%d %H:%M:%S')] [ERROR] $1" >&2
}

log_warn() {
    echo "[$(date '+%Y-%m-%d %H:%M:%S')] [WARN] $1"
}

# ============================================================
# DataNode 配置
# ============================================================
HADOOP_HOME="${INSTALL_BASE_DIR}/{{.Instance.Vars.install_subdir}}"
DN_DATA_DIR="${DATA_BASE_DIR}/{{.Instance.Vars.datanode_data_subdir}}"

# ============================================================
# 开始部署
# ============================================================
echo "============================================"
echo "Hadoop 3 DataNode 准备脚本"
echo "============================================"
echo "主机名: $(hostname)"
echo "DataNode数据目录: ${DN_DATA_DIR}"
echo "============================================"

# ============================================================
# 步骤1: 检查Hadoop安装
# ============================================================
log_info "步骤1: 检查Hadoop安装..."
if [ ! -d "${HADOOP_HOME}" ]; then
    log_error "Hadoop未安装，请先在NameNode节点执行 install_binary.sh"
    log_error "或手动安装Hadoop二进制包"
    exit 1
fi
log_info "Hadoop安装检查通过"

# ============================================================
# 步骤2: 检查配置文件
# ============================================================
log_info "步骤2: 检查配置文件..."
if [ ! -f "${HADOOP_HOME}/etc/hadoop/core-site.xml" ]; then
    log_error "配置文件不存在，请先部署配置文件"
    exit 1
fi
log_info "配置文件检查通过"

# ============================================================
# 步骤3: 创建数据目录
# ============================================================
log_info "步骤3: 创建数据目录..."
if [ ! -d "${DN_DATA_DIR}" ]; then
    run_as_root mkdir -p "${DN_DATA_DIR}"
    run_as_root chown -R ${RUN_USER}:${RUN_GROUP} "${DN_DATA_DIR}"
    run_as_root chmod 755 "${DN_DATA_DIR}"
    log_info "数据目录创建完成: ${DN_DATA_DIR}"
else
    run_as_root chown -R ${RUN_USER}:${RUN_GROUP} "${DN_DATA_DIR}"
    log_info "数据目录已存在: ${DN_DATA_DIR}"
fi

# ============================================================
# 步骤4: 创建Socket目录
# ============================================================
log_info "步骤4: 创建Socket目录..."
SOCKETS_DIR="${DATA_BASE_DIR}/{{.Instance.Vars.install_subdir}}/hdfs-sockets/dn"
run_as_root mkdir -p "${SOCKETS_DIR}"
run_as_root chmod 755 "${SOCKETS_DIR}"
run_as_root chown -R ${RUN_USER}:${RUN_GROUP} "${SOCKETS_DIR}"
run_as_root chmod g-w "${SOCKETS_DIR}"
log_info "Socket目录创建完成"

# ============================================================
# 步骤5: 创建PID和日志目录
# ============================================================
log_info "步骤5: 创建PID和日志目录..."

run_as_root mkdir -p "${HADOOP_HOME}/pids"
run_as_root chmod 755 "${HADOOP_HOME}/pids"
run_as_root chown ${RUN_USER}:${RUN_GROUP} "${HADOOP_HOME}/pids"

run_as_root mkdir -p "${HADOOP_HOME}/logs"
run_as_root chmod 755 "${HADOOP_HOME}/logs"
run_as_root chown ${RUN_USER}:${RUN_GROUP} "${HADOOP_HOME}/logs"

log_info "目录准备完成"

# ============================================================
# 步骤6: 部署systemd服务文件
# ============================================================
log_info "步骤6: 部署systemd服务文件..."

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
SERVICE_FILE="hadoop-hdfs-datanode.service"

if [ -f "${SCRIPT_DIR}/${SERVICE_FILE}" ]; then
    run_as_root cp "${SCRIPT_DIR}/${SERVICE_FILE}" /etc/systemd/system/
    run_as_root chmod 644 "/etc/systemd/system/${SERVICE_FILE}"
    run_as_root systemctl daemon-reload
    log_info "systemd服务文件部署完成"
else
    log_warn "systemd服务文件不存在"
fi

# ============================================================
# 部署完成
# ============================================================
echo ""
echo "============================================"
echo "DataNode 准备完成！"
echo "============================================"
echo ""
echo "启动DataNode (在NameNode启动后):"
echo "  systemctl start hadoop-hdfs-datanode"
echo ""
echo "设置开机自启:"
echo "  systemctl enable hadoop-hdfs-datanode"
