#!/bin/bash
# Hadoop 3 JournalNode 启动脚本
# 使用方法: bash start_journalnode.sh
# 说明: 在所有 JournalNode 节点执行，启动 JournalNode 服务
# 注意: JournalNode 必须首先启动，因为后续步骤需要连接它们

set -e

# ============================================================
# 全局变量
# ============================================================
INSTALL_BASE_DIR="{{.Global.install_base_dir}}"
DATA_BASE_DIR="{{.Global.data_base_dir}}"
RUN_USER="{{.Global.user}}"
RUN_GROUP="{{.Global.group}}"
JAVA_HOME="{{.Global.java_home}}"

# ============================================================
# 辅助函数
# ============================================================
run_as_root() {
    if [ "$RUN_USER" = "root" ]; then
        "$@"
    else
        sudo "$@"
    fi
}

log_info() {
    echo "[$(date '+%Y-%m-%d %H:%M:%S')] [INFO] $1"
}

log_error() {
    echo "[$(date '+%Y-%m-%d %H:%M:%S')] [ERROR] $1" >&2
}

log_warn() {
    echo "[$(date '+%Y-%m-%d %H:%M:%S')] [WARN] $1"
}

log_success() {
    echo "[$(date '+%Y-%m-%d %H:%M:%S')] [SUCCESS] $1"
}

check_port() {
    local port=$1
    if netstat -tuln 2>/dev/null | grep -q ":${port} " || ss -tuln 2>/dev/null | grep -q ":${port} "; then
        return 0
    fi
    return 1
}

# ============================================================
# Hadoop 配置
# ============================================================
HADOOP_HOME="${INSTALL_BASE_DIR}/{{.Instance.Vars.install_subdir}}"
HADOOP_CONF_DIR="${HADOOP_HOME}/etc/hadoop"
JN_DATA_DIR="${DATA_BASE_DIR}/{{.Instance.Vars.journalnode_data_subdir}}"
JN_PORT="{{.Instance.Vars.journalnode_port}}"
PID_FILE="${HADOOP_HOME}/pids/hadoop-hdfs-journalnode.pid"

# ============================================================
# 开始启动
# ============================================================
echo "============================================"
echo "Hadoop 3 JournalNode 启动脚本"
echo "============================================"
echo "主机名: $(hostname)"
echo "JournalNode 数据目录: ${JN_DATA_DIR}"
echo "JournalNode 端口: ${JN_PORT}"
echo "============================================"

# 设置环境变量
export JAVA_HOME=${JAVA_HOME}
export HADOOP_HOME=${HADOOP_HOME}
export HADOOP_CONF_DIR=${HADOOP_CONF_DIR}
export HDFS_JOURNALNODE_USER=${RUN_USER}
export HDFS_NAMENODE_USER=${RUN_USER}
export HDFS_DATANODE_USER=${RUN_USER}
export HDFS_ZKFC_USER=${RUN_USER}
export YARN_RESOURCEMANAGER_USER=${RUN_USER}
export YARN_NODEMANAGER_USER=${RUN_USER}

PATH=${HADOOP_HOME}/bin:${HADOOP_HOME}/sbin:${PATH}

# ============================================================
# 步骤1: 检查前置条件
# ============================================================
log_info "步骤1: 检查前置条件..."

# 检查Hadoop安装
if [ ! -d "${HADOOP_HOME}" ]; then
    log_error "Hadoop未安装，请先执行 install_binary.sh"
    exit 1
fi

# 检查配置文件
if [ ! -f "${HADOOP_CONF_DIR}/hdfs-site.xml" ]; then
    log_error "配置文件不存在，请先执行 deploy_config.sh"
    exit 1
fi

# 检查数据目录
if [ ! -d "${JN_DATA_DIR}" ]; then
    log_error "数据目录不存在，请先执行 setup_dirs.sh"
    exit 1
fi

log_info "前置条件检查通过"

# ============================================================
# 步骤2: 检查是否已运行
# ============================================================
log_info "步骤2: 检查 JournalNode 状态..."

if [ -f "${PID_FILE}" ]; then
    PID=$(cat "${PID_FILE}")
    if ps -p ${PID} > /dev/null 2>&1; then
        log_info "JournalNode 已在运行 (PID: ${PID})"
        exit 0
    else
        log_info "清理残留 PID 文件"
        rm -f "${PID_FILE}"
    fi
fi

# 检查端口
if check_port "${JN_PORT}"; then
    log_warn "端口 ${JN_PORT} 已被占用"
    exit 0
fi

# ============================================================
# 步骤3: 启动 JournalNode
# ============================================================
log_info "步骤3: 启动 JournalNode..."

# 使用 hdfs --daemon start journalnode
${HADOOP_HOME}/bin/hdfs --daemon start journalnode

# 等待启动
sleep 3

# ============================================================
# 步骤4: 验证启动
# ============================================================
log_info "步骤4: 验证启动..."

# 检查进程
if [ -f "${PID_FILE}" ]; then
    PID=$(cat "${PID_FILE}")
    if ps -p ${PID} > /dev/null 2>&1; then
        log_success "JournalNode 启动成功 (PID: ${PID})"
    else
        log_error "JournalNode 启动失败"
        exit 1
    fi
else
    log_error "JournalNode PID 文件未创建"
    exit 1
fi

# 检查端口
sleep 2
if check_port "${JN_PORT}"; then
    log_success "端口 ${JN_PORT} 正在监听"
else
    log_warn "端口 ${JN_PORT} 未监听，请检查日志"
fi

# ============================================================
# 步骤5: 部署 systemd 服务文件（可选）
# ============================================================
log_info "步骤5: 部署 systemd 服务文件（可选）..."

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
SERVICE_FILE="${SCRIPT_DIR}/systemd/hadoop-hdfs-journalnode.service"

if [ -f "${SERVICE_FILE}" ]; then
    run_as_root cp "${SERVICE_FILE}" /etc/systemd/system/
    run_as_root chmod 644 /etc/systemd/system/hadoop-hdfs-journalnode.service
    run_as_root systemctl daemon-reload
    log_info "systemd 服务文件已部署"
    log_info "可使用 systemctl 管理服务"
fi

# ============================================================
# 启动完成
# ============================================================
echo ""
echo "============================================"
echo "JournalNode 启动完成！"
echo "============================================"
echo ""
echo "检查状态:"
echo "  jps | grep JournalNode"
echo "  netstat -tuln | grep ${JN_PORT}"
echo ""
echo "日志文件:"
echo "  ${HADOOP_HOME}/logs/hadoop-${RUN_USER}-journalnode-$(hostname).log"
echo ""
echo "后续步骤:"
echo "  在所有 JournalNode 节点执行此脚本"
echo "  然后在主 NameNode 节点执行: bash init_namenode_master.sh"
