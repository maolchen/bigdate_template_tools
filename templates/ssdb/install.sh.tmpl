#!/bin/bash
# ============================================================
# SSDB 安装脚本 (编译安装，多实例)
# 服务: ssdb
# 节点: {{ .Instance.Node.NodeName }} ({{ .Instance.Node.IP }})
# 注意: SSDB 编译安装目录固定为 /usr/local/ssdb，不能修改
# ============================================================

set -e

# ==================== 颜色定义 ====================
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

# ==================== 变量定义 ====================
SSDB_VERSION="{{ .Instance.Vars.version }}"
INSTALL_DIR="{{ .Instance.Vars.install_dir }}"
SOURCE_PACKAGE="{{ .Global.software_dir }}/{{ .Instance.Vars.package_subdir }}/${SSDB_VERSION}.zip"
TEMP_DIR="{{ .Global.temp_dir }}"
RUN_USER="{{ .Global.user }}"
RUN_GROUP="{{ .Global.group }}"
DATA_BASE_DIR="{{ .Global.data_base_dir }}"

# ==================== 日志函数 ====================
log_info() {
    echo -e "${GREEN}[INFO]${NC} $1"
}

log_warn() {
    echo -e "${YELLOW}[WARN]${NC} $1"
}

log_error() {
    echo -e "${RED}[ERROR]${NC} $1"
}

log_success() {
    echo -e "${GREEN}[SUCCESS]${NC} $1"
}

# ==================== 检查函数 ====================
check_source_package() {
    if [ ! -f "$SOURCE_PACKAGE" ]; then
        log_error "SSDB安装包不存在: $SOURCE_PACKAGE"
        return 1
    fi
    log_success "安装包检查通过"
    return 0
}

# ==================== 停止所有实例 ====================
stop_all_instances() {
    log_info "停止所有SSDB实例..."
    
    # 检查是否有正在运行的进程
    SSDB_PROC_COUNT=$(pgrep -f "ssdb-server.*conf" | wc -l 2>/dev/null || echo "0")
    
    if [ "$SSDB_PROC_COUNT" -gt 0 ]; then
        log_info "发现 $SSDB_PROC_COUNT 个运行中的SSDB进程，正在停止..."
        
        # 逐个停止实例
        {{- range $i, $inst := .Instance.Vars.instances }}
        if pgrep -f "ssdb-server.*{{ $inst.port }}" > /dev/null 2>&1; then
            log_info "停止 SSDB 实例 (端口: {{ $inst.port }})..."
            pkill -f "ssdb-server.*{{ $inst.port }}" || true
        fi
        {{- end }}
        
        sleep 3
        
        # 强制终止残留进程
        if pgrep -f "ssdb-server" > /dev/null 2>&1; then
            log_warn "强制终止残留进程..."
            pkill -9 -f "ssdb-server" || true
            sleep 2
        fi
    fi
    
    log_success "所有实例已停止"
}

# ==================== 创建数据目录 ====================
create_data_dirs() {
    log_info "创建数据目录..."
    
    {{- range $i, $inst := .Instance.Vars.instances }}
    mkdir -p "${DATA_BASE_DIR}/{{ $inst.data_subdir }}"
    log_info "创建目录: ${DATA_BASE_DIR}/{{ $inst.data_subdir }}"
    {{- end }}
    
    log_success "数据目录创建完成"
}

# ==================== 解压安装包 ====================
extract_package() {
    log_info "解压SSDB安装包..."
    
    # 创建临时目录
    mkdir -p "$TEMP_DIR"
    
    # 解压 zip 文件
    if command -v unzip &> /dev/null; then
        unzip -o "$SOURCE_PACKAGE" -d "$TEMP_DIR"
    else
        log_error "unzip 命令不存在，请先安装 unzip"
        exit 1
    fi
    
    log_success "解压完成: $TEMP_DIR/${SSDB_VERSION}"
}

# ==================== 编译安装 ====================
compile_install() {
    log_info "检查是否已安装SSDB..."
    
    # 检查是否已安装
    if [ -f "${INSTALL_DIR}/ssdb-server" ]; then
        log_warn "SSDB已安装，跳过编译步骤"
        return 0
    fi
    
    log_info "编译安装SSDB..."
    
    cd "$TEMP_DIR/${SSDB_VERSION}"
    
    # 编译
    log_info "执行 make..."
    make -j$(nproc)
    
    # 安装（安装到默认目录 /usr/local/ssdb）
    log_info "执行 make install..."
    make install
    
    if [ ! -f "${INSTALL_DIR}/ssdb-server" ]; then
        log_error "SSDB 安装失败，找不到 ssdb-server"
        exit 1
    fi
    
    log_success "编译安装完成: $INSTALL_DIR"
}

# ==================== 生成配置文件 ====================
generate_configs() {
    log_info "生成SSDB配置文件..."
    
    {{- $bind := .Instance.Vars.bind }}
    {{- $work_rps := .Instance.Vars.work_rps }}
    {{- $work_threads := .Instance.Vars.work_threads }}
    {{- $cache_size := .Instance.Vars.cache_size }}
    {{- $block_size := .Instance.Vars.block_size }}
    {{- $compaction_speed := .Instance.Vars.compaction_speed }}
    {{- $write_buffer_size := .Instance.Vars.write_buffer_size }}
    {{- $compression := .Instance.Vars.compression }}
    {{- $dataBaseDir := .Global.data_base_dir }}
    
    {{- range $i, $inst := .Instance.Vars.instances }}
    # ==================== 实例 {{ $inst.port }} ====================
    cat > "${INSTALL_DIR}/{{ $inst.config_file }}" << 'SSDB_CONF_EOF'
# SSDB配置文件 - 端口 {{ $inst.port }}
# 节点: {{ $.Instance.Node.NodeName }} ({{ $.Instance.Node.IP }})

# 监听地址
bind {{ $bind }}
port {{ $inst.port }}

# 工作目录
work_dir = {{ $dataBaseDir }}/{{ $inst.data_subdir }}
pidfile = {{ $dataBaseDir }}/{{ $inst.data_subdir }}/ssdb.pid

# 性能参数
work_rps = {{ $work_rps }}
work_threads = {{ $work_threads }}

# 缓存配置
cache_size = {{ $cache_size }}
block_size = {{ $block_size }}

# 压缩与写入
compaction_speed = {{ $compaction_speed }}
write_buffer_size = {{ $write_buffer_size }}
compression = {{ $compression }}

# 日志
logger {
    level = debug
    output = {{ $dataBaseDir }}/{{ $inst.data_subdir }}/ssdb.log
    rotate {
        size = 1000000000
        num = 10
    }
}

# leveldb 配置
leveldb {
    cache_size = {{ $cache_size }}
    block_size = {{ $block_size }}
    write_buffer_size = {{ $write_buffer_size }}
    compaction_speed = {{ $compaction_speed }}
    compression = {{ $compression }}
}
SSDB_CONF_EOF
    log_info "配置文件已生成: ${INSTALL_DIR}/{{ $inst.config_file }}"
    
    {{- end }}
    
    log_success "所有配置文件生成完成"
}

# ==================== 生成启动/停止脚本 ====================
generate_scripts() {
    log_info "生成启动和停止脚本..."
    
    # 启动脚本
    cat > "${INSTALL_DIR}/start_ssdb_all.sh" << 'START_SCRIPT_EOF'
#!/bin/bash
# SSDB 启动所有实例脚本

INSTALL_DIR="{{ .Instance.Vars.install_dir }}"
SSDB_SERVER="${INSTALL_DIR}/ssdb-server"

echo "启动所有SSDB实例..."

{{- range $i, $inst := .Instance.Vars.instances }}
if pgrep -f "ssdb-server.*{{ $inst.port }}" > /dev/null 2>&1; then
    echo "实例 {{ $inst.port }} 已在运行"
else
    echo "启动实例 {{ $inst.port }}..."
    ${SSDB_SERVER} ${INSTALL_DIR}/{{ $inst.config_file }} -d
    sleep 1
fi
{{- end }}

echo "所有实例启动完成"
START_SCRIPT_EOF
    chmod +x "${INSTALL_DIR}/start_ssdb_all.sh"
    log_info "启动脚本已生成: ${INSTALL_DIR}/start_ssdb_all.sh"
    
    # 停止脚本
    cat > "${INSTALL_DIR}/stop_ssdb_all.sh" << 'STOP_SCRIPT_EOF'
#!/bin/bash
# SSDB 停止所有实例脚本

echo "停止所有SSDB实例..."

{{- range $i, $inst := .Instance.Vars.instances }}
if pgrep -f "ssdb-server.*{{ $inst.port }}" > /dev/null 2>&1; then
    echo "停止实例 {{ $inst.port }}..."
    pkill -f "ssdb-server.*{{ $inst.port }}"
fi
{{- end }}

sleep 2

# 强制终止残留进程
if pgrep -f "ssdb-server" > /dev/null 2>&1; then
    echo "强制终止残留进程..."
    pkill -9 -f "ssdb-server"
fi

echo "所有实例已停止"
STOP_SCRIPT_EOF
    chmod +x "${INSTALL_DIR}/stop_ssdb_all.sh"
    log_info "停止脚本已生成: ${INSTALL_DIR}/stop_ssdb_all.sh"
    
    log_success "脚本生成完成"
}

# ==================== 设置权限 ====================
set_permissions() {
    log_info "设置目录权限..."
    
    chown -R ${RUN_USER}:${RUN_GROUP} "$INSTALL_DIR"
    {{- range $i, $inst := .Instance.Vars.instances }}
    chown -R ${RUN_USER}:${RUN_GROUP} "${DATA_BASE_DIR}/{{ $inst.data_subdir }}"
    {{- end }}
    
    log_success "权限设置完成"
}

# ==================== 启动所有实例 ====================
start_all_instances() {
    log_info "启动所有SSDB实例..."
    
    # 检查是否有运行中的进程
    SSDB_PROC_COUNT=$(pgrep -f "ssdb-server.*conf" | wc -l 2>/dev/null || echo "0")
    EXPECTED_COUNT={{ len .Instance.Vars.instances }}
    
    if [ "$SSDB_PROC_COUNT" -ge "$EXPECTED_COUNT" ]; then
        log_warn "所有实例已在运行中"
        return 0
    fi
    
    # 使用启动脚本
    sh "${INSTALL_DIR}/start_ssdb_all.sh"
    
    # 等待启动
    sleep 3
    
    # 验证端口
    {{- range $i, $inst := .Instance.Vars.instances }}
    if netstat -tuln 2>/dev/null | grep -q ":{{ $inst.port }} "; then
        log_success "SSDB 实例 {{ $inst.port }} 启动成功"
    else
        log_error "SSDB 实例 {{ $inst.port }} 启动失败"
        exit 1
    fi
    {{- end }}
    
    log_success "所有实例启动完成"
}

# ==================== 添加开机启动 ====================
add_startup_scripts() {
    log_info "配置开机启动..."
    
    # 确保 rc.local 可执行
    if [ -f /etc/rc.local ]; then
        chmod +x /etc/rc.local
    fi
    
    START_CMD="su - ${RUN_USER} -c 'sh ${INSTALL_DIR}/start_ssdb_all.sh'"
    
    if ! grep -q "start_ssdb_all.sh" /etc/rc.local 2>/dev/null; then
        if grep -q "^exit 0" /etc/rc.local 2>/dev/null; then
            sed -i "/^exit 0/i ${START_CMD}" /etc/rc.local
        else
            echo "${START_CMD}" >> /etc/rc.local
        fi
        log_info "已添加到开机启动"
    fi
    
    log_success "开机启动配置完成"
}

# ==================== 显示状态 ====================
show_status() {
    echo ""
    echo "============================================"
    echo "SSDB 安装完成"
    echo "============================================"
    echo "版本: ${SSDB_VERSION}"
    echo "安装目录: ${INSTALL_DIR}"
    echo ""
    echo "实例列表:"
    {{- range $i, $inst := .Instance.Vars.instances }}
    echo "  - 端口: {{ $inst.port }}"
    echo "    配置: ${INSTALL_DIR}/{{ $inst.config_file }}"
    echo "    数据: ${DATA_BASE_DIR}/{{ $inst.data_subdir }}"
    echo ""
    {{- end }}
    echo "管理命令:"
    echo "  启动所有: sh ${INSTALL_DIR}/start_ssdb_all.sh"
    echo "  停止所有: sh ${INSTALL_DIR}/stop_ssdb_all.sh"
    echo "  单实例: ${INSTALL_DIR}/ssdb-server <config_file> -d"
    echo "  客户端: ${INSTALL_DIR}/ssdb-cli -p <port>"
    echo "============================================"
}

# ==================== 主函数 ====================
main() {
    log_info "开始安装 SSDB ${SSDB_VERSION}..."
    echo ""
    
    # 检查安装包
    check_source_package || exit 1
    
    # 停止旧实例
    stop_all_instances
    
    # 创建数据目录
    create_data_dirs
    
    # 解压
    extract_package
    
    # 编译安装
    compile_install
    
    # 生成配置
    generate_configs
    
    # 生成脚本
    generate_scripts
    
    # 设置权限
    set_permissions
    
    # 启动实例
    start_all_instances
    
    # 添加开机启动
    add_startup_scripts
    
    # 显示状态
    show_status
    
    log_success "SSDB 安装完成！"
}

# 执行主函数
main "$@"
