#!/bin/bash
# ============================================================
# Redis 安装脚本 (编译安装，多实例)
# 服务: redis
# 节点: {{ .Instance.Node.NodeName }} ({{ .Instance.Node.IP }})
# ============================================================

set -e

# ==================== 颜色定义 ====================
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

# ==================== 变量定义 ====================
REDIS_VERSION="{{ .Instance.Vars.version }}"
INSTALL_DIR="{{ .Instance.Vars.install_dir }}"
SOURCE_PACKAGE="{{ .Global.software_dir }}/{{ .Instance.Vars.package_subdir }}/redis-${REDIS_VERSION}.tar.gz"
TEMP_DIR="{{ .Global.temp_dir }}"
RUN_USER="{{ .Instance.Vars.run_user }}"
RUN_GROUP="{{ .Instance.Vars.run_group }}"

# ==================== 日志函数 ====================
log_info() {
    echo -e "${GREEN}[INFO]${NC} $1"
}

log_warn() {
    echo -e "${YELLOW}[WARN]${NC} $1"
}

log_error() {
    echo -e "${RED}[ERROR]${NC} $1"
}

log_success() {
    echo -e "${GREEN}[SUCCESS]${NC} $1"
}

# ==================== 检查函数 ====================
check_source_package() {
    if [ ! -f "$SOURCE_PACKAGE" ]; then
        log_error "Redis安装包不存在: $SOURCE_PACKAGE"
        return 1
    fi
    log_success "安装包检查通过"
    return 0
}

# ==================== 停止所有实例 ====================
stop_all_instances() {
    log_info "停止所有Redis实例..."
    
    # 实例列表
    INSTANCES='{{- $instances := .Instance.Vars.instances -}}{{- range $i, $inst := $instances }}{{ if $i }} {{ end }}{{ $inst.port }}{{- end }}'
    
    for PORT in $INSTANCES; do
        PID_FILE="/var/run/redis_${PORT}.pid"
        if [ -f "$PID_FILE" ]; then
            log_info "停止 Redis 实例 (端口: $PORT)..."
            PID=$(cat "$PID_FILE")
            if kill -0 "$PID" 2>/dev/null; then
                kill "$PID"
                log_info "已发送停止信号到进程 $PID"
            fi
            rm -f "$PID_FILE"
        fi
        
        # 通过进程名检查
        if pgrep -f "redis.*${PORT}" > /dev/null 2>&1; then
            log_warn "发现残留进程，强制终止..."
            pkill -f "redis.*${PORT}"
            sleep 2
        fi
    done
    
    log_success "所有实例已停止"
}

# ==================== 清理旧安装 ====================
clean_old_install() {
    log_info "清理旧安装目录..."
    
    if [ -d "$INSTALL_DIR" ]; then
        log_warn "删除旧安装目录: $INSTALL_DIR"
        rm -rf "$INSTALL_DIR"
    fi
    
    # 清理数据目录
    INSTANCES='{{- range $i, $inst := .Instance.Vars.instances }}{{ if $i }} {{ end }}{{ $inst.data_dir }}{{- end }}'
    for DATA_DIR in $INSTANCES; do
        if [ -d "$DATA_DIR" ]; then
            log_warn "删除旧数据目录: $DATA_DIR"
            rm -rf "$DATA_DIR"
        fi
    done
    
    log_success "清理完成"
}

# ==================== 创建目录 ====================
create_directories() {
    log_info "创建安装和数据目录..."
    
    # 创建安装目录
    mkdir -p "$INSTALL_DIR"
    
    # 创建数据目录
    {{- range $i, $inst := .Instance.Vars.instances }}
    mkdir -p "{{ $inst.data_dir }}"
    {{- end }}
    
    # 创建临时目录
    mkdir -p "$TEMP_DIR"
    
    log_success "目录创建完成"
}

# ==================== 解压安装包 ====================
extract_package() {
    log_info "解压Redis安装包..."
    
    tar -xzf "$SOURCE_PACKAGE" -C "$TEMP_DIR"
    
    log_success "解压完成: $TEMP_DIR/redis-${REDIS_VERSION}"
}

# ==================== 编译安装 ====================
compile_install() {
    log_info "编译安装Redis..."
    
    cd "$TEMP_DIR/redis-${REDIS_VERSION}"
    
    # 编译
    log_info "执行 make..."
    make -j$(nproc)
    
    # 安装
    log_info "执行 make install..."
    make install PREFIX="$INSTALL_DIR"
    
    log_success "编译安装完成: $INSTALL_DIR"
}

# ==================== 生成配置文件 ====================
generate_configs() {
    log_info "生成Redis配置文件..."
    
    {{- $bind := .Instance.Vars.bind }}
    {{- $daemonize := .Instance.Vars.daemonize }}
    {{- $timeout := .Instance.Vars.timeout }}
    {{- $tcp_keepalive := .Instance.Vars.tcp_keepalive }}
    {{- $loglevel := .Instance.Vars.loglevel }}
    {{- $databases := .Instance.Vars.databases }}
    {{- $maxmemory := .Instance.Vars.maxmemory }}
    {{- $maxmemory_policy := .Instance.Vars.maxmemory_policy }}
    {{- $appendonly := .Instance.Vars.appendonly }}
    {{- $appendfsync := .Instance.Vars.appendfsync }}
    
    {{- range $i, $inst := .Instance.Vars.instances }}
    # ==================== 实例 {{ $inst.port }} ====================
    cat > "${INSTALL_DIR}/redis_{{ $inst.port }}.conf" << 'REDIS_CONF_EOF'
# Redis配置文件 - 端口 {{ $inst.port }}
# 节点: {{ $.Instance.Node.NodeName }} ({{ $.Instance.Node.IP }})

# 网络配置
bind {{ $bind }}
port {{ $inst.port }}
timeout {{ $timeout }}
tcp-keepalive {{ $tcp_keepalive }}

# 通用配置
daemonize {{ $daemonize }}
pidfile /var/run/{{ $inst.pid_file }}
logfile {{ $inst.data_dir }}/{{ $inst.logfile }}
loglevel {{ $loglevel }}
databases {{ $databases }}

# 数据目录
dir {{ $inst.data_dir }}

# 内存管理
maxmemory {{ $maxmemory }}
maxmemory-policy {{ $maxmemory_policy }}

# RDB持久化
save 900 1
save 300 10
save 60 10000
stop-writes-on-bgsave-error yes
rdbcompression yes
rdbchecksum yes
dbfilename dump.rdb

# AOF持久化
appendonly {{ $appendonly }}
appendfilename "appendonly.aof"
appendfsync {{ $appendfsync }}
no-appendfsync-on-rewrite no
auto-aof-rewrite-percentage 100
auto-aof-rewrite-min-size 64mb

# 慢查询日志
slowlog-log-slower-than 10000
slowlog-max-len 128

# 客户端配置
maxclients 10000
REDIS_CONF_EOF
    log_info "配置文件已生成: ${INSTALL_DIR}/redis_{{ $inst.port }}.conf"
    
    {{- end }}
    
    log_success "所有配置文件生成完成"
}

# ==================== 设置权限 ====================
set_permissions() {
    log_info "设置目录权限..."
    
    chown -R ${RUN_USER}:${RUN_GROUP} "$INSTALL_DIR"
    {{- range $i, $inst := .Instance.Vars.instances }}
    chown -R ${RUN_USER}:${RUN_GROUP} "{{ $inst.data_dir }}"
    {{- end }}
    
    log_success "权限设置完成"
}

# ==================== 启动所有实例 ====================
start_all_instances() {
    log_info "启动所有Redis实例..."
    
    {{- range $i, $inst := .Instance.Vars.instances }}
    # 启动实例 {{ $inst.port }}
    log_info "启动 Redis 实例 (端口: {{ $inst.port }})..."
    su - ${RUN_USER} -c "${INSTALL_DIR}/bin/redis-server ${INSTALL_DIR}/redis_{{ $inst.port }}.conf"
    
    # 等待启动
    sleep 2
    
    # 检查端口
    if netstat -tuln 2>/dev/null | grep -q ":{{ $inst.port }} "; then
        log_success "Redis 实例 {{ $inst.port }} 启动成功"
    else
        log_error "Redis 实例 {{ $inst.port }} 启动失败"
        exit 1
    fi
    
    {{- end }}
    
    log_success "所有实例启动完成"
}

# ==================== 创建软链接 ====================
create_symlinks() {
    log_info "创建redis-cli软链接..."
    
    if [ -f "${INSTALL_DIR}/bin/redis-cli" ]; then
        ln -sf "${INSTALL_DIR}/bin/redis-cli" /usr/bin/redis-cli
        log_success "软链接创建完成: /usr/bin/redis-cli"
    fi
}

# ==================== 添加开机启动 ====================
add_startup_scripts() {
    log_info "配置开机启动..."
    
    # 确保 rc.local 可执行
    if [ -f /etc/rc.local ]; then
        chmod +x /etc/rc.local
    fi
    
    # 添加启动命令
    {{- range $i, $inst := .Instance.Vars.instances }}
    START_CMD_{{ $inst.port }}="su - ${RUN_USER} -c '${INSTALL_DIR}/bin/redis-server ${INSTALL_DIR}/redis_{{ $inst.port }}.conf'"
    
    if ! grep -q "redis_{{ $inst.port }}" /etc/rc.local 2>/dev/null; then
        if grep -q "^exit 0" /etc/rc.local 2>/dev/null; then
            sed -i "/^exit 0/i ${START_CMD_{{ $inst.port }}}" /etc/rc.local
        else
            echo "${START_CMD_{{ $inst.port }}}" >> /etc/rc.local
        fi
        log_info "已添加实例 {{ $inst.port }} 到开机启动"
    fi
    {{- end }}
    
    log_success "开机启动配置完成"
}

# ==================== 显示状态 ====================
show_status() {
    echo ""
    echo "============================================"
    echo "Redis 安装完成"
    echo "============================================"
    echo "版本: ${REDIS_VERSION}"
    echo "安装目录: ${INSTALL_DIR}"
    echo ""
    echo "实例列表:"
    {{- range $i, $inst := .Instance.Vars.instances }}
    echo "  - 端口: {{ $inst.port }}"
    echo "    配置: ${INSTALL_DIR}/redis_{{ $inst.port }}.conf"
    echo "    数据: {{ $inst.data_dir }}"
    echo ""
    {{- end }}
    echo "管理命令:"
    echo "  查看状态: redis-cli -p <port> info"
    echo "  连接实例: redis-cli -p <port>"
    echo "  停止实例: redis-cli -p <port> shutdown"
    echo "============================================"
}

# ==================== 主函数 ====================
main() {
    log_info "开始安装 Redis ${REDIS_VERSION}..."
    echo ""
    
    # 检查安装包
    check_source_package || exit 1
    
    # 停止旧实例
    stop_all_instances
    
    # 清理旧安装
    clean_old_install
    
    # 创建目录
    create_directories
    
    # 解压
    extract_package
    
    # 编译安装
    compile_install
    
    # 生成配置
    generate_configs
    
    # 设置权限
    set_permissions
    
    # 启动实例
    start_all_instances
    
    # 创建软链接
    create_symlinks
    
    # 添加开机启动
    add_startup_scripts
    
    # 显示状态
    show_status
    
    log_success "Redis 安装完成！"
}

# 执行主函数
main "$@"
