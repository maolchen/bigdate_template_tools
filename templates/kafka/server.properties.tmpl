# ============================================================
# Kafka Server 配置文件
# 节点: {{.Instance.NodeName}}
# IP: {{.Instance.Node.IP}}
# broker.id: {{.Instance.AutoID}}
# ============================================================

# Broker ID（自动推导）
broker.id={{.Instance.AutoID}}

# 监听地址
listeners=PLAINTEXT://{{.Instance.Node.IP}}:{{.Instance.Vars.broker_port}}
advertised.listeners=PLAINTEXT://{{.Instance.Node.IP}}:{{.Instance.Vars.broker_port}}

# 日志目录
log.dirs={{.Global.data_base_dir}}/kafka/logs

# ============================================================
# Zookeeper连接（通过模板函数动态获取）
# 使用 serviceEndpointsJoin 函数获取 zookeeper 服务的所有端点
# ============================================================
zookeeper.connect={{serviceEndpointsJoin "zookeeper" "client_port"}}

# 分区数量
num.partitions={{.Instance.Vars.num_partitions}}

# 默认副本因子
default.replication.factor={{.Instance.Vars.default_replication_factor}}

# 日志保留时间（小时）
log.retention.hours={{.Instance.Vars.log_retention_hours}}

# 日志段大小
log.segment.bytes=1073741824

# 日志清理策略
log.cleanup.policy=delete

# 线程配置
num.network.threads=3
num.io.threads=8
socket.send.buffer.bytes=102400
socket.receive.buffer.bytes=102400
socket.request.max.bytes=104857600

# 组协调器配置
group.initial.rebalance.delay.ms=0
