# ============================================================
# Kafka 配置文件
# 主机: {{ .Hostname }} ({{ .IP }})
# 节点: {{ .NodeName }} (索引: {{ .NodeIndex }}, broker_id: {{ .AutoID }})
# ============================================================

# Broker ID（自动推导）
broker.id={{ .AutoID }}

# 监听地址
listeners=PLAINTEXT://{{ .IP }}:{{ .ServiceVars.broker_port }}
advertised.listeners=PLAINTEXT://{{ .IP }}:{{ .ServiceVars.broker_port }}

# 日志目录
log.dirs={{ globalVar "install_base_dir" }}/kafka/logs

# ============================================================
# Zookeeper 配置（自动生成连接串）
# ============================================================
zookeeper.connect={{ .Derived.zk_connect_string }}
zookeeper.connection.timeout.ms=6000

# ============================================================
# 日志配置
# ============================================================
num.partitions={{ .ServiceVars.num_partitions }}
default.replication.factor={{ .ServiceVars.default_replication_factor }}
log.retention.hours={{ .ServiceVars.log_retention_hours }}
log.segment.bytes=1073741824
log.retention.check.interval.ms=300000

# ============================================================
# 性能配置
# ============================================================
num.network.threads=3
num.io.threads=8
socket.send.buffer.bytes=102400
socket.receive.buffer.bytes=102400
socket.request.max.bytes=104857600

# ============================================================
# 其他配置
# ============================================================
auto.create.topics.enable=true
delete.topic.enable=true
