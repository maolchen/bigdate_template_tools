[Unit]
Description=Hadoop YARN NodeManager
Documentation=https://hadoop.apache.org/docs/stable/hadoop-yarn/hadoop-yarn-site/YARN.html
After=network.target network-online.target hadoop-yarn-resourcemanager.service
Wants=network-online.target
Requires=hadoop-yarn-resourcemanager.service

[Service]
Type=forking
User=bigdata
Group=bigdata
Environment="JAVA_HOME=/data/jdk/"
Environment="HADOOP_HOME=/data/localization/hadoop"
Environment="HADOOP_CONF_DIR=/data/localization/hadoop/etc/hadoop"
Environment="YARN_CONF_DIR=/data/localization/hadoop/etc/hadoop"
ExecStart=/data/localization/hadoop/bin/yarn --daemon start nodemanager
ExecStop=/data/localization/hadoop/bin/yarn --daemon stop nodemanager
PIDFile=/data/localization/hadoop/pids/yarn-bigdata-nodemanager.pid
Restart=on-failure
RestartSec=10

# 安全加固
LimitNOFILE=65536
LimitNPROC=65536

[Install]
WantedBy=multi-user.target
