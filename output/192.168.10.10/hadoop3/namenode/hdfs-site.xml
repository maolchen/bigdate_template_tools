<?xml version="1.0"?>
<?xml-stylesheet type="text/xsl" href="configuration.xsl"?>
<configuration>

<!-- 权限配置 -->
<property>
  <name>dfs.permissions.superusergroup</name>
  <value>bigdata</value>
</property>

<property>
  <name>fs.permissions.umask-mode</name>
  <value>022</value>
</property>

<property>
  <name>dfs.namenode.acls.enabled</name>
  <value>true</value>
</property>

<!-- DataNode数据目录 -->
<property>
  <name>dfs.datanode.data.dir</name>
  <value>file:///data/dfs/dn</value>
</property>

<!-- HDFS块大小 -->
<property>
  <name>dfs.blocksize</name>
  <value>268435456</value>
</property>
 
<!-- Nameservice配置 -->
<property>
  <name>dfs.nameservices</name>
  <value>zhugeio</value>
</property>
 
<!-- NameNode数据目录 -->
<property>
  <name>dfs.namenode.name.dir</name>
  <value>file:///data/dfs/nn</value>
</property>
 
<!-- HA NameNode列表 -->
<property>
  <name>dfs.ha.namenodes.zhugeio</name>
  <value>dw-master1,dw-master2</value>
</property>





<!-- NameNode RPC地址: dw-master1 -->
<property>
  <name>dfs.namenode.rpc-address.zhugeio.dw-master1</name>
  <value>dw-master1:8020</value>
</property>

<!-- NameNode HTTP地址: dw-master1 -->
<property>
  <name>dfs.namenode.http-address.zhugeio.dw-master1</name>
  <value>dw-master1:50070</value>
</property>

<!-- NameNode RPC地址: dw-master2 -->
<property>
  <name>dfs.namenode.rpc-address.zhugeio.dw-master2</name>
  <value>dw-master2:8020</value>
</property>

<!-- NameNode HTTP地址: dw-master2 -->
<property>
  <name>dfs.namenode.http-address.zhugeio.dw-master2</name>
  <value>dw-master2:50070</value>
</property>


<!-- JournalNode共享编辑目录 -->
<property>
  <name>dfs.namenode.shared.edits.dir</name>
  <value>qjournal://dw-master1:8485;dw-master2:8485;dw-master3:8485/zhugeio</value>
</property>

<!-- 故障转移代理提供者 -->
<property>
  <name>dfs.client.failover.proxy.provider.zhugeio</name>
  <value>org.apache.hadoop.hdfs.server.namenode.ha.ConfiguredFailoverProxyProvider</value>
</property>
 
<!-- 故障转移SSH配置 -->
<property>
  <name>dfs.ha.fencing.ssh.private-key-files</name>
  <value>/home/bigdata/.ssh/id_rsa</value>
</property>

<property>
  <name>dfs.ha.fencing.methods</name>
  <value>shell(/bin/true)</value>
</property>

<!-- JournalNode编辑目录 -->
<property>
  <name>dfs.journalnode.edits.dir</name>
  <value>/data/dfs/jn</value>
</property>

<!-- 自动故障转移 -->
<property>
  <name>dfs.ha.automatic-failover.enabled</name>
  <value>true</value>
</property>

<!-- 短路读取配置 -->
<property>
  <name>dfs.datanode.hdfs-blocks-metadata.enabled</name>
  <value>true</value>
</property>

<property>
  <name>dfs.client.read.shortcircuit</name>
  <value>true</value>
</property>

<property>
  <name>dfs.domain.socket.path</name>
  <value>/data/hadoop/hdfs-sockets/dn</value>
</property>

</configuration>
