[Unit]
Description=Hadoop YARN ResourceManager
Documentation=https://hadoop.apache.org/docs/stable/hadoop-yarn/hadoop-yarn-site/YARN.html
After=network.target network-online.target zookeeper.service hadoop-hdfs-namenode.service
Wants=network-online.target
Requires=zookeeper.service hadoop-hdfs-namenode.service

[Service]
Type=forking
User=bigdata
Group=bigdata
Environment="JAVA_HOME=/data/jdk/"
Environment="HADOOP_HOME=/data/localization/hadoop"
Environment="HADOOP_CONF_DIR=/data/localization/hadoop/etc/hadoop"
Environment="YARN_CONF_DIR=/data/localization/hadoop/etc/hadoop"
ExecStart=/data/localization/hadoop/bin/yarn --daemon start resourcemanager
ExecStop=/data/localization/hadoop/bin/yarn --daemon stop resourcemanager
PIDFile=/data/localization/hadoop/pids/yarn-bigdata-resourcemanager.pid
Restart=on-failure
RestartSec=10

# 安全加固
LimitNOFILE=65536
LimitNPROC=65536

[Install]
WantedBy=multi-user.target
